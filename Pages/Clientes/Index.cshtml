@page
@model TallerMecanico.Pages.Clientes.IndexModel

@{
    ViewData["Title"] = "Gestión de Clientes";
}

<div class="dashboard">

    <div class="dashboard-header">
        <div>
            <h1>Gestión de Clientes</h1>
            <p>Administra los clientes registrados en el taller.</p>
        </div>

        <button type="button"
                class="services-btn services-btn-primary"
                id="abrir-crear-cliente">
            + Nuevo Cliente
        </button>
    </div>

    @if (Model.BorradorVehiculoId.HasValue)
    {
        <a asp-page="/Vehiculos/Index" asp-page-handler="Retomar"
           asp-route-borradorId="@Model.BorradorVehiculoId" class="services-btn services-btn-secondary">
            Volver al vehículo sin registrar cliente
        </a>
    }

    @if (!string.IsNullOrEmpty(Model.MensajeExito))
    {
        <div class="service-validation"
             style="margin-bottom: 16px;"
             role="status">
            @Model.MensajeExito
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.MensajeError))
    {
        <div class="service-validation"
             style="margin-bottom: 16px;"
             role="alert">
            @Model.MensajeError
        </div>
    }

    <div class="services-actions"
         style="margin-bottom: 20px;">

        <form method="get"
              class="buscador"
              role="search">

            <input asp-for="BorradorVehiculoId" type="hidden" />

            <span class="buscador-icono"
                  aria-hidden="true">
                🔍
            </span>

            <label asp-for="TerminoBusqueda"
                   class="visually-hidden">
                Buscar clientes
            </label>

            <input asp-for="TerminoBusqueda"
                   class="service-input buscador-input"
                   placeholder="Buscar por CI, nombre, apellido o celular"
                   autocomplete="off" />

            <button type="submit"
                    class="services-btn services-btn-secondary">
                Buscar
            </button>

            @if (!string.IsNullOrWhiteSpace(Model.TerminoBusqueda))
            {
                <a asp-page="./Index"
                   class="services-btn services-btn-secondary">
                    Limpiar
                </a>
            }
        </form>

        <a asp-page="./Index"
           class="services-btn services-btn-secondary">
            Refrescar
        </a>
    </div>

    <section class="recent-orders">

        <div class="section-header">
            <div>
                <h2>
                    Clientes Registrados
                    (@Model.Clientes.Count)
                </h2>
            </div>
        </div>

        @if (Model.Clientes.Count == 0)
        {
            <div class="services-empty">

                <div class="services-empty-icon">
                    👤
                </div>

                <strong>
                    @(string.IsNullOrWhiteSpace(Model.TerminoBusqueda)
                        ? "No existen clientes registrados"
                        : "No se encontraron coincidencias")
                </strong>

                <span>
                    @(string.IsNullOrWhiteSpace(Model.TerminoBusqueda)
                        ? "Registra un cliente para comenzar."
                        : "Prueba con otro CI, nombre, apellido o celular.")
                </span>

            </div>
        }
        else
        {
            <div class="table-container">

                <table class="orders-table services-table">

                    <thead>
                        <tr>
                            <th>CI</th>
                            <th>Nombres</th>
                            <th>Primer Apellido</th>
                            <th>Segundo Apellido</th>
                            <th>Celular</th>
                            <th>Creado por</th>
                            <th>Fecha de creación</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var cliente in Model.Clientes)
                        {
                            <tr>

                                <td class="service-name">
                                    @(string.IsNullOrEmpty(cliente.ComplementoCi)
                                        ? cliente.Ci
                                        : $"{cliente.Ci}-{cliente.ComplementoCi}")
                                </td>

                                <td>
                                    @cliente.Nombres
                                </td>

                                <td>
                                    @cliente.PrimerApellido
                                </td>

                                <td>
                                    @cliente.SegundoApellido
                                </td>

                                <td>
                                    @cliente.Celular
                                </td>

                                <td>
                                    @cliente.CreadoPor
                                </td>

                                <td>
                                    @cliente.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    <div class="services-row-actions">

                                        <button type="button"
                                                class="service-action service-action-icon service-action-edit"
                                                title="Editar cliente"
                                                data-editar-cliente
                                                data-id="@cliente.Id"
                                                data-ci="@cliente.Ci"
                                                data-complemento-ci="@cliente.ComplementoCi"
                                                data-nombres="@cliente.Nombres"
                                                data-primer-apellido="@cliente.PrimerApellido"
                                                data-segundo-apellido="@cliente.SegundoApellido"
                                                data-celular="@cliente.Celular">
                                            ✎
                                        </button>

                                        <button type="button"
                                                class="service-action service-action-icon service-action-delete"
                                                title="Eliminar cliente"
                                                data-eliminar-cliente
                                                data-id="@cliente.Id"
                                                data-nombre="@cliente.Nombres @cliente.PrimerApellido @cliente.SegundoApellido">
                                            🗑
                                        </button>

                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </section>

</div>


<!-- ================================================= -->
<!-- MODAL CREAR / EDITAR CLIENTE                     -->
<!-- ================================================= -->

<dialog id="cliente-form-dialog"
        class="modal-dialog"
        data-open-mode="@Model.FormularioActivo">

    <div class="service-form-header">

        <div>
            <h2 id="cliente-form-title">
                Nuevo Cliente
            </h2>

            <p id="cliente-form-description">
                Completa los datos para registrar un cliente.
            </p>
        </div>

        <button type="button"
                class="modal-close"
                data-cerrar-cliente
                aria-label="Cerrar">
            &times;
        </button>

    </div>

    <form method="post"
          class="service-form"
          id="cliente-form">

        <input asp-for="ClienteId"
               type="hidden"
               id="cliente-id" />

        <input type="hidden"
               name="TerminoBusqueda"
               value="@Model.TerminoBusqueda" />

        <input asp-for="BorradorVehiculoId" type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="service-validation">
        </div>


        <!-- CI + COMPLEMENTO -->

        <div style="
            display: grid;
            grid-template-columns: minmax(0, 3fr) auto minmax(120px, 1fr);
            gap: 12px;
            align-items: end;
            margin-bottom: 20px;">

            <div class="service-form-group">

                <label asp-for="ClienteInput.Ci">
                    Número de CI
                    <span class="campo-obligatorio">*</span>
                </label>

                <input asp-for="ClienteInput.Ci"
                       id="cliente-ci"
                       class="service-input"
                       maxlength="8"
                       inputmode="numeric"
                       autocomplete="off"
                       placeholder="Ej. 1234567" />

                <span asp-validation-for="ClienteInput.Ci"
                      class="service-validation">
                </span>

            </div>

            <div style="
                padding-bottom: 14px;
                font-size: 20px;">
                -
            </div>

            <div class="service-form-group">

                <div style="
                    display: flex;
                    justify-content: space-between;
                    gap: 10px;">

                    <label asp-for="ClienteInput.ComplementoCi">
                        Complemento
                    </label>

                    <span style="opacity: .65;">
                        Opcional
                    </span>

                </div>

                <input asp-for="ClienteInput.ComplementoCi"
                       id="cliente-complemento-ci"
                       class="service-input"
                       maxlength="2"
                       autocomplete="off"
                       placeholder="Ej. 1A" />

                <span asp-validation-for="ClienteInput.ComplementoCi"
                      class="service-validation">
                </span>

            </div>

        </div>


        <!-- CELULAR + NOMBRES -->

        <div style="
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 24px;
            margin-bottom: 20px;">

            <div class="service-form-group">

                <label asp-for="ClienteInput.Celular">
                    Celular
                    <span class="campo-obligatorio">*</span>
                </label>

                <input asp-for="ClienteInput.Celular"
                       id="cliente-celular"
                       class="service-input"
                       maxlength="8"
                       inputmode="numeric"
                       autocomplete="tel"
                       placeholder="Ej. 70712345" />

                <span asp-validation-for="ClienteInput.Celular"
                      class="service-validation">
                </span>

            </div>

            <div class="service-form-group">

                <label asp-for="ClienteInput.Nombres">
                    Nombres
                    <span class="campo-obligatorio">*</span>
                </label>

                <input asp-for="ClienteInput.Nombres"
                       id="cliente-nombres"
                       class="service-input"
                       maxlength="100"
                       autocomplete="given-name"
                       placeholder="Ej. Juan Carlos" />

                <span asp-validation-for="ClienteInput.Nombres"
                      class="service-validation">
                </span>

            </div>

        </div>


        <!-- PRIMER Y SEGUNDO APELLIDO -->

        <div style="
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 24px;
            margin-bottom: 20px;">

            <div class="service-form-group">

                <label asp-for="ClienteInput.PrimerApellido">
                    Primer Apellido
                    <span class="campo-obligatorio">*</span>
                </label>

                <input asp-for="ClienteInput.PrimerApellido"
                       id="cliente-primer-apellido"
                       class="service-input"
                       maxlength="100"
                       autocomplete="family-name"
                       placeholder="Ej. Pérez" />

                <span asp-validation-for="ClienteInput.PrimerApellido"
                      class="service-validation">
                </span>

            </div>

            <div class="service-form-group">

                <label asp-for="ClienteInput.SegundoApellido">
                    Segundo Apellido
                    <span class="campo-obligatorio">*</span>
                </label>

                <input asp-for="ClienteInput.SegundoApellido"
                       id="cliente-segundo-apellido"
                       class="service-input"
                       maxlength="100"
                       autocomplete="family-name"
                       placeholder="Ej. Mercado" />

                <span asp-validation-for="ClienteInput.SegundoApellido"
                      class="service-validation">
                </span>

            </div>

        </div>


        <div class="service-form-actions">

            @if (Model.BorradorVehiculoId.HasValue)
            {
                <a asp-page="/Vehiculos/Index" asp-page-handler="Retomar"
                   asp-route-borradorId="@Model.BorradorVehiculoId" class="services-btn services-btn-secondary">
                    Cancelar y volver al vehículo
                </a>
            }

            <button type="button"
                    class="services-btn services-btn-secondary"
                    data-cerrar-cliente>
                Cancelar
            </button>

            <button type="submit"
                    asp-page-handler="Crear"
                    class="services-btn services-btn-primary"
                    id="cliente-boton-crear">
                Guardar Cliente
            </button>

            <button type="submit"
                    asp-page-handler="Actualizar"
                    class="services-btn services-btn-primary"
                    id="cliente-boton-actualizar"
                    hidden>
                Guardar Cambios
            </button>

        </div>

    </form>

</dialog>


<!-- ================================================= -->
<!-- MODAL ELIMINAR                                   -->
<!-- ================================================= -->

<dialog id="cliente-delete-dialog"
        class="modal-dialog">

    <div class="service-form-header">

        <div>
            <h2>Eliminar Cliente</h2>

            <p>
                Confirma la eliminación del cliente seleccionado.
            </p>
        </div>

        <button type="button"
                class="modal-close"
                data-cerrar-eliminar-cliente
                aria-label="Cerrar">
            &times;
        </button>

    </div>

    <form method="post"
          asp-page-handler="Eliminar"
          class="service-form">

        <input type="hidden"
               name="ClienteId"
               id="cliente-eliminar-id" />

        <input type="hidden"
               name="TerminoBusqueda"
               value="@Model.TerminoBusqueda" />

        <div class="service-delete-warning">

            <strong id="cliente-eliminar-nombre">
            </strong>

            <span>
                Este registro será eliminado del sistema.
            </span>

        </div>

        <div class="service-form-actions">

            <button type="button"
                    class="services-btn services-btn-secondary"
                    data-cerrar-eliminar-cliente>
                Cancelar
            </button>

            <button type="submit"
                    class="services-btn services-btn-danger">
                Eliminar Cliente
            </button>

        </div>

    </form>

</dialog>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {

            const dialogFormulario =
                document.getElementById("cliente-form-dialog");

            const dialogEliminar =
                document.getElementById("cliente-delete-dialog");

            const botonNuevo =
                document.getElementById("abrir-crear-cliente");

            const tituloFormulario =
                document.getElementById("cliente-form-title");

            const descripcionFormulario =
                document.getElementById("cliente-form-description");

            const inputId =
                document.getElementById("cliente-id");

            const inputCi =
                document.getElementById("cliente-ci");

            const inputComplementoCi =
                document.getElementById("cliente-complemento-ci");

            const inputNombres =
                document.getElementById("cliente-nombres");

            const inputPrimerApellido =
                document.getElementById("cliente-primer-apellido");

            const inputSegundoApellido =
                document.getElementById("cliente-segundo-apellido");

            const inputCelular =
                document.getElementById("cliente-celular");

            const botonCrear =
                document.getElementById("cliente-boton-crear");

            const botonActualizar =
                document.getElementById("cliente-boton-actualizar");


            function abrirCrear() {

                inputId.value = "0";
                inputCi.value = "";
                inputComplementoCi.value = "";
                inputNombres.value = "";
                inputPrimerApellido.value = "";
                inputSegundoApellido.value = "";
                inputCelular.value = "";

                tituloFormulario.textContent =
                    "Nuevo Cliente";

                descripcionFormulario.textContent =
                    "Completa los datos para registrar un cliente.";

                botonCrear.hidden = false;
                botonActualizar.hidden = true;

                dialogFormulario.showModal();
            }


            function abrirEditar(boton) {

                inputId.value =
                    boton.dataset.id ?? "";

                inputCi.value =
                    boton.dataset.ci ?? "";

                inputComplementoCi.value =
                    boton.dataset.complementoCi ?? "";

                inputNombres.value =
                    boton.dataset.nombres ?? "";

                inputPrimerApellido.value =
                    boton.dataset.primerApellido ?? "";

                inputSegundoApellido.value =
                    boton.dataset.segundoApellido ?? "";

                inputCelular.value =
                    boton.dataset.celular ?? "";

                tituloFormulario.textContent =
                    "Editar Cliente";

                descripcionFormulario.textContent =
                    "Modifica los datos del cliente y guarda los cambios.";

                botonCrear.hidden = true;
                botonActualizar.hidden = false;

                dialogFormulario.showModal();
            }


            botonNuevo?.addEventListener(
                "click",
                abrirCrear);


            document
                .querySelectorAll("[data-editar-cliente]")
                .forEach(boton => {

                    boton.addEventListener(
                        "click",
                        () => abrirEditar(boton));

                });


            document
                .querySelectorAll("[data-cerrar-cliente]")
                .forEach(boton => {

                    boton.addEventListener(
                        "click",
                        () => dialogFormulario.close());

                });


            document
                .querySelectorAll("[data-eliminar-cliente]")
                .forEach(boton => {

                    boton.addEventListener(
                        "click",
                        () => {

                            document.getElementById(
                                "cliente-eliminar-id"
                            ).value =
                                boton.dataset.id ?? "";

                            document.getElementById(
                                "cliente-eliminar-nombre"
                            ).textContent =
                                boton.dataset.nombre ?? "";

                            dialogEliminar.showModal();

                        });

                });


            document
                .querySelectorAll(
                    "[data-cerrar-eliminar-cliente]"
                )
                .forEach(boton => {

                    boton.addEventListener(
                        "click",
                        () => dialogEliminar.close());

                });


            const modoInicial =
                dialogFormulario?.dataset.openMode;

            if (modoInicial === "crear") {

                botonCrear.hidden = false;
                botonActualizar.hidden = true;

                dialogFormulario.showModal();
            }

            if (modoInicial === "editar") {

                botonCrear.hidden = true;
                botonActualizar.hidden = false;

                tituloFormulario.textContent =
                    "Editar Cliente";

                descripcionFormulario.textContent =
                    "Corrige los datos indicados y vuelve a guardar.";

                dialogFormulario.showModal();
            }

        })();
    </script>
}
