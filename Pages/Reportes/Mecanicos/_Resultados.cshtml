@model TallerMecanico.Pages.Reportes.Mecanicos.IndexModel

@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alerta" role="alert">@Model.MensajeError</div>
}
<div class="acciones" data-total-mecanicos="@(Model.Documento?.Filas.Count ?? 0)">
    <form method="post" asp-page="./Index" asp-page-handler="ExportarPdf" style="margin:0;">
        <input type="hidden" asp-for="Filtro.NombreMecanico" />
        <button type="submit" class="btn btn-primary" data-exportar-reporte>Exportar PDF</button>
    </form>
    <form method="post" asp-page="./Index" asp-page-handler="ExportarExcel" style="margin:0;">
        <input type="hidden" asp-for="Filtro.NombreMecanico" />
        <button type="submit" class="btn btn-outline-secondary" data-exportar-reporte>Exportar Excel</button>
    </form>
</div>
    @if (Model.Documento is null || Model.Documento.Filas.Count == 0)
    {
        <div class="table-responsive">
            <div class="vacío">
                <p>No se encontraron registros de mecánicos con los criterios seleccionados.</p>
            </div>
        </div>
    }
    else
    {
        var documento = Model.Documento!;
        decimal maximo = documento.Filas.Any()
            ? documento.Filas.Max(f => f.TotalFacturado)
            : 0;
        if (maximo <= 0) maximo = 1;

        <section class="estadisticas" aria-label="Resumen del reporte estadístico">
            <div class="estadistica">
                <span class="etiqueta">Mecánicos</span>
                <strong class="valor">@documento.Resumen.TotalMecanicos</strong>
            </div>
            <div class="estadistica">
                <span class="etiqueta">Órdenes totales</span>
                <strong class="valor">@documento.Resumen.TotalOrdenes</strong>
            </div>
            <div class="estadistica">
                <span class="etiqueta">Total facturado</span>
                <strong class="valor">@documento.Resumen.TotalFacturado.ToString("N2")</strong>
            </div>
        </section>

        <section class="grafico-panel" aria-label="Gráfico de barras por mecánico">
            <h2>Distribución del total facturado por mecánico</h2>
            @foreach (var fila in documento.Filas)
            {
                decimal porcentaje = maximo > 0
                    ? (decimal)fila.TotalFacturado / maximo * 100
                    : 0;

                <div class="grafico-barra">
                    <span class="grafico-etiqueta">@fila.NombreMecanico</span>
                    <div class="grafico-progreso">
                        <div class="grafico-relleno"
                             style="width:@porcentaje.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;"></div>
                    </div>
                    <span class="grafico-valor">@fila.TotalFacturado.ToString("N2")</span>
                </div>
            }
        </section>

        <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th># Mecánico</th>
                        <th>Mecánico</th>
                        <th>C.I.</th>
                        <th class="text-end">Órdenes</th>
                        <th class="text-end">Total facturado</th>
                        <th class="text-end">Promedio por orden</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fila in documento.Filas)
                    {
                        <tr>
                            <td>@fila.MecanicoId</td>
                            <td>@fila.NombreMecanico</td>
                            <td>@fila.CiMecanico</td>
                            <td class="text-end">@fila.TotalOrdenes.ToString("N0")</td>
                            <td class="text-end">@fila.TotalFacturado.ToString("N2")</td>
                            <td class="text-end">@fila.PromedioPorOrden.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="pie">
            <span>Reporte generado por @documento.GeneradoPor el @DateTime.SpecifyKind(documento.FechaGeneracion, DateTimeKind.Utc).AddHours(-4).ToString("dd/MM/yyyy HH:mm") (hora de Bolivia)</span>
            <span class="float-end">AutoTaller Pro</span>
        </div>
    }
