@page
@model TallerMecanico.Pages.Reportes.Mecanicos.IndexModel
@{
    ViewData["Title"] = "Reporte Estadístico por Mecánico";
}

<style>
    .hu3-reporte-mecanicos {
        max-width: 1400px;
        color: var(--text-primary);
    }

    .hu3-reporte-mecanicos h1 {
        font-weight: 700;
        letter-spacing: -0.5px;
    }

    .hu3-reporte-mecanicos .text-muted {
        color: var(--text-muted) !important;
    }

    .hu3-reporte-mecanicos .form-control:focus {
        border-color: var(--primary-hover);
        box-shadow: 0 0 0 3px var(--primary-soft);
    }

    .hu3-reporte-mecanicos .filtros {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 22px;
        margin-bottom: 20px;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 16px;
        align-items: end;
    }

    .hu3-reporte-mecanicos .form-label {
        color: var(--text-secondary);
        font-weight: 600;
        font-size: 0.85rem;
        display: block;
        margin-bottom: 6px;
    }

    .hu3-reporte-mecanicos .form-control,
    .hu3-reporte-mecanicos .form-select {
        background-color: var(--surface-light);
        color: var(--text-primary);
        border: 1px solid var(--border-light);
        border-radius: var(--radius-sm);
        min-height: 40px;
        width: 100%;
    }

    .hu3-reporte-mecanicos .acciones {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 18px;
    }

    .hu3-reporte-mecanicos .btn {
        border-radius: var(--radius-sm);
        font-weight: 600;
        padding: 8px 16px;
        font-size: 0.85rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .hu3-reporte-mecanicos .btn-primary {
        background: var(--primary);
        border-color: var(--primary);
        color: #fff;
    }

    .hu3-reporte-mecanicos .btn-primary:hover {
        background: var(--primary-hover);
    }

    .hu3-reporte-mecanicos .btn-outline-secondary {
        color: var(--primary-hover);
        border-color: var(--primary);
    }

    .hu3-reporte-mecanicos .btn-outline-secondary:hover {
        background: var(--primary);
        color: #fff;
    }

    .hu3-reporte-mecanicos .estadisticas {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 20px;
    }

    .hu3-reporte-mecanicos .estadistica {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 18px;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .hu3-reporte-mecanicos .estadistica .etiqueta {
        color: var(--text-secondary);
        font-size: 0.8rem;
        font-weight: 600;
    }

    .hu3-reporte-mecanicos .estadistica .valor {
        color: var(--text-primary);
        font-size: 1.75rem;
        font-weight: 700;
    }

    .hu3-reporte-mecanicos .estadistica:first-child {
        border-top: 3px solid var(--primary);
    }

    .hu3-reporte-mecanicos .grafico-panel {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 20px;
        margin-bottom: 20px;
    }

    .hu3-reporte-mecanicos .grafico-panel h2 {
        color: var(--text-primary);
        font-size: 1rem;
        font-weight: 700;
        margin: 0 0 14px;
    }

    .hu3-reporte-mecanicos .grafico-barra {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 10px;
        height: 30px;
    }

    .hu3-reporte-mecanicos .grafico-etiqueta {
        width: 150px;
        flex-shrink: 0;
        font-size: 0.85rem;
        color: var(--text-secondary);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .hu3-reporte-mecanicos .grafico-progreso {
        flex: 1;
        height: 100%;
        background: var(--surface-hover);
        border-radius: var(--radius-sm);
        overflow: hidden;
        position: relative;
    }

    .hu3-reporte-mecanicos .grafico-relleno {
        height: 100%;
        background: var(--primary);
        border-radius: var(--radius-sm);
        transition: width 0.5s ease;
    }

    .hu3-reporte-mecanicos .grafico-valor {
        width: 110px;
        flex-shrink: 0;
        text-align: right;
        font-size: 0.85rem;
        color: var(--text-primary);
        font-weight: 600;
    }

    .hu3-reporte-mecanicos .table-responsive {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        overflow: auto;
        margin-bottom: 20px;
    }

    .hu3-reporte-mecanicos table {
        width: 100%;
        border-collapse: collapse;
    }

    .hu3-reporte-mecanicos th {
        background: var(--surface-light);
        color: var(--text-secondary);
        font-size: 0.8rem;
        font-weight: 600;
        text-align: left;
        padding: 12px 14px;
        border-bottom: 1px solid var(--border);
        white-space: nowrap;
    }

    .hu3-reporte-mecanicos td {
        color: var(--text-primary);
        padding: 11px 14px;
        border-bottom: 1px solid var(--border);
        font-size: 0.9rem;
        vertical-align: middle;
    }

    .hu3-reporte-mecanicos td.text-end {
        text-align: right;
    }

    .hu3-reporte-mecanicos .vacío {
        text-align: center;
        padding: 40px;
        color: var(--text-secondary);
    }

    .hu3-reporte-mecanicos .alerta {
        background: var(--surface-light);
        color: var(--text-primary);
        border: 1px solid var(--border-light);
        border-radius: var(--radius-md);
        padding: 14px;
        margin-bottom: 16px;
        font-size: 0.9rem;
    }

    .hu3-reporte-mecanicos .pie {
        margin-top: 24px;
        color: var(--text-muted);
        font-size: 0.8rem;
        border-top: 1px solid var(--border);
        padding-top: 12px;
    }

    @@media (max-width: 768px) {
        .hu3-reporte-mecanicos .estadisticas {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .hu3-reporte-mecanicos .acciones {
            flex-direction: column;
        }
        .hu3-reporte-mecanicos .grafico-barra {
            flex-direction: column;
            align-items: stretch;
            gap: 6px;
            height: auto;
        }
        .hu3-reporte-mecanicos .grafico-etiqueta,
        .hu3-reporte-mecanicos .grafico-valor {
            width: auto;
            text-align: left;
        }
        .hu3-reporte-mecanicos .grafico-valor {
            text-align: right;
            margin-left: auto;
        }
    }
</style>

<div class="container py-4 hu3-reporte-mecanicos">
    <nav aria-label="Navegación de reportes"
         style="display:flex;gap:12px;flex-wrap:wrap;margin-bottom:24px;">
        <a asp-page="/Reportes/Index" class="btn btn-outline-secondary">
            Centro de reportes
        </a>
        <a asp-page="/Reportes/Ordenes/Index" class="btn btn-outline-secondary">
            Órdenes
        </a>
        <a asp-page="/Reportes/Mecanicos/Index" class="btn btn-outline-secondary">
            Mecánicos
        </a>
    </nav>
    <div class="mb-4">
        <h1>Reporte estadístico por mecánico</h1>
        <p class="text-muted">Consulta las órdenes y la facturación por nombre del mecánico.</p>
    </div>

    <form method="get" class="filtros" id="reporte-mecanicos-filtros"
          asp-page="./Index" role="search">
        <div>
            <label asp-for="Filtro.NombreMecanico" class="form-label">Nombre del mecánico</label>
            <input asp-for="Filtro.NombreMecanico" type="search" class="form-control"
                   maxlength="300" autocomplete="off"
                   placeholder="Escribe un nombre o apellido…"
                   aria-controls="reporte-mecanicos-resultados" />
            <p class="text-muted" style="margin:8px 0 0;font-size:.85rem;">
                Los resultados se filtran mientras escribes.
            </p>
        </div>
        <div>
            <button type="submit" class="btn btn-primary">Buscar</button>
        </div>
    </form>
    <p id="reporte-mecanicos-estado" role="status" aria-live="polite"></p>
    <div id="reporte-mecanicos-resultados">
        <partial name="_Resultados" model="Model" />
    </div>
</div>

@section Scripts {
    <script src="~/js/reporte-mecanicos.js" asp-append-version="true"></script>
}
