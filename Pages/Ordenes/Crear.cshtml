@page
@model TallerMecanico.Pages.Ordenes.CrearModel
@using System.Globalization
@using TallerMecanico.Pages.Shared
@{
    ViewData["Title"] = "Crear orden";
    var fechaOrden = Model.FechaOrden;
}

<div class="dashboard ordenes-page nueva-orden-page">
    <div class="dashboard-header">
        <div><p class="ordenes-kicker">GESTIÓN DE ÓRDENES</p><h1>Nueva orden de trabajo</h1><p>Completa los datos del trabajo y revisa el total antes de guardar.</p></div>
        <a asp-page="./Index" class="services-btn services-btn-secondary">Volver a órdenes</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Mensaje)) { <div class="service-validation" role="status">@Model.Mensaje</div> }
    <div asp-validation-summary="ModelOnly" class="service-validation" role="alert"></div>

    <form method="post" id="formulario-orden" asp-page-handler="Guardar"
          data-vehiculo-url="@Url.Page("./Crear", "VehiculoSeleccionado")"
          data-servicio-url="@Url.Page("./Crear", "ServicioSeleccionado")"
          data-costo-servicio="@Model.CostoServiciosSeleccionados.ToString(CultureInfo.InvariantCulture)">
        <input type="hidden" asp-for="Formulario.Token" />
        <input type="hidden" asp-for="BorradorId" />
        <input type="hidden" name="ProductoId" value="@Model.ProductoId" />
        <input type="hidden" name="BuscarProducto" value="@Model.BuscarProducto" />
        @for (var indice = 0; indice < Model.Formulario.Lineas.Count; indice++)
        {
            <input type="hidden" name="Formulario.Lineas[@indice].ProductoId" value="@Model.Formulario.Lineas[indice].ProductoId" />
            <input type="hidden" name="Formulario.Lineas[@indice].Cantidad" value="@Model.Formulario.Lineas[indice].Cantidad" />
            <input type="hidden" name="Formulario.Lineas[@indice].Precio" value="@Model.Formulario.Lineas[indice].Precio" />
        }
        <section class="recent-orders ordenes-card ordenes-selectores-card">
            <div class="ordenes-titulo-seccion"><span class="ordenes-paso">1</span><div><h2>Datos del trabajo</h2><p>Selecciona los registros existentes que participarán en la orden.</p></div></div>
            <div class="ordenes-cabecera">
                <div class="ordenes-selector">
                    <partial name="_BuscadorAutocompletado" model='new BuscadorAutocompletadoModel
                    {
                        Id = "orden-vehiculo", UrlSugerencias = Url.Page("./Crear", "SugerenciasVehiculos")!,
                        Modo = BuscadorAutocompletadoModel.ModoSeleccionar,
                        Etiqueta = "Vehículo", Placeholder = "Buscar por placa, marca o modelo...",
                        NombreCampoTexto = nameof(Model.BuscarVehiculo), NombreCampoId = "Formulario.VehiculoId",
                        Texto = Model.BuscarVehiculo ?? string.Empty, IdSeleccionado = Model.VehiculoSeleccionado?.Id
                    }' />
                    <p class="ordenes-ayuda">El cliente de la orden será el asociado al vehículo seleccionado.</p>
                    <p id="orden-vehiculo-aviso" role="status" hidden="@(Model.VehiculoSeleccionado?.ClienteId.HasValue != false)">El vehículo requiere un cliente antes de guardar la orden.</p>
                    <span asp-validation-for="Formulario.VehiculoId" class="service-validation"></span>
                </div>
                <div class="ordenes-selector ordenes-servicios-selector"
                     data-servicio-pendiente-id="@Model.ServicioSeleccionado?.Id"
                     data-servicio-pendiente-nombre="@Model.ServicioSeleccionado?.Nombre"
                     data-servicio-pendiente-costo="@(Model.ServicioSeleccionado?.Costo.ToString(CultureInfo.InvariantCulture) ?? "")"
                     data-servicio-pendiente-tiempo="@(Model.ServicioSeleccionado?.TiempoEstimadoHoras.ToString(CultureInfo.InvariantCulture) ?? "")">
                    <partial name="_BuscadorAutocompletado" model='new BuscadorAutocompletadoModel
                    {
                        Id = "orden-servicio", UrlSugerencias = Url.Page("./Crear", "SugerenciasServicios")!,
                        Modo = BuscadorAutocompletadoModel.ModoSeleccionar,
                        Etiqueta = "Servicios a realizar", Placeholder = "Buscar un servicio por nombre...",
                        NombreCampoTexto = nameof(Model.TextoServicio), NombreCampoId = "Formulario.ServicioId",
                        Texto = Model.TextoServicio ?? string.Empty, IdSeleccionado = Model.ServicioSeleccionado?.Id
                    }' />
                    <div class="ordenes-servicio-agregar">
                        <p id="orden-servicio-costo" role="status">@(Model.ServicioSeleccionado is null ? "Busca y selecciona un servicio para agregarlo." : $"Bs. {Model.ServicioSeleccionado.Costo:0.00} · {Model.ServicioSeleccionado.TiempoEstimadoHoras:0.##} h")</p>
                        <button type="button" id="orden-agregar-servicio" class="services-btn services-btn-secondary" disabled="@(Model.ServicioSeleccionado is null)">Agregar servicio</button>
                    </div>
                    <p id="orden-servicio-mensaje" class="ordenes-ayuda" role="status" aria-live="polite"></p>
                    <span asp-validation-for="Formulario.ServicioIds" class="service-validation"></span>
                    <div id="orden-servicios-seleccionados" class="ordenes-servicios-seleccionados" aria-label="Servicios agregados a la orden">
                        @for (var indice = 0; indice < Model.ServiciosSeleccionados.Count; indice++)
                        {
                            var servicio = Model.ServiciosSeleccionados[indice];
                            <article class="ordenes-servicio-seleccionado" data-servicio-seleccionado data-servicio-id="@servicio.Id" data-costo="@servicio.Costo.ToString(CultureInfo.InvariantCulture)">
                                <input type="hidden" name="Formulario.ServicioIds" value="@servicio.Id" />
                                <div><strong data-servicio-nombre>@servicio.Nombre</strong><span>Bs. @servicio.Costo.ToString("0.00") · @servicio.TiempoEstimadoHoras.ToString("0.##") h</span></div>
                                <button type="button" class="services-btn services-btn-secondary" data-quitar-servicio aria-label="Quitar @servicio.Nombre">Quitar</button>
                            </article>
                        }
                    </div>
                </div>
                <div class="ordenes-selector">
                    <partial name="_BuscadorAutocompletado" model='new BuscadorAutocompletadoModel
                    {
                        Id = "orden-mecanico", UrlSugerencias = Url.Page("./Crear", "SugerenciasMecanicos")!,
                        Modo = BuscadorAutocompletadoModel.ModoSeleccionar,
                        Etiqueta = "Mecánico", Placeholder = "Buscar por CI, nombres o apellidos...",
                        NombreCampoTexto = nameof(Model.TextoMecanico), NombreCampoId = "Formulario.MecanicoId",
                        Texto = Model.TextoMecanico ?? string.Empty, IdSeleccionado = Model.MecanicoSeleccionado?.Id
                    }' />
                    <span asp-validation-for="Formulario.MecanicoId" class="service-validation"></span>
                </div>
                <div class="ordenes-fecha">
                    <span id="orden-fecha-etiqueta">Fecha de la orden</span>
                    <time class="service-input" aria-labelledby="orden-fecha-etiqueta"
                          datetime="@fechaOrden.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@fechaOrden.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)</time>
                </div>
            </div>
        </section>
    </form>

    <section class="recent-orders ordenes-card ordenes-selectores-card">
        <div class="ordenes-titulo-seccion"><span class="ordenes-paso">2</span><div><h2>Repuestos <span class="ordenes-opcional">Opcional</span></h2><p>Agrega productos existentes. El stock se actualiza al guardar.</p></div></div>
        <form method="post" id="orden-agregar-producto" asp-page-handler="AgregarLinea" class="ordenes-agregar">
            <partial name="_ContextoNuevaOrden" model="Model" />
            <div class="ordenes-selector">
                <partial name="_BuscadorAutocompletado" model='new BuscadorAutocompletadoModel
                {
                    Id = "orden-producto", UrlSugerencias = Url.Page("./Crear", "SugerenciasProductos")!,
                    Modo = BuscadorAutocompletadoModel.ModoSeleccionar,
                    Etiqueta = "Producto", Placeholder = "Buscar por código o nombre...",
                    NombreCampoTexto = nameof(Model.BuscarProducto), NombreCampoId = nameof(Model.ProductoId),
                    Texto = Model.BuscarProducto ?? string.Empty, IdSeleccionado = Model.ProductoSeleccionado?.Id
                }' />
            </div>
            <label>Cantidad
                <input asp-for="Cantidad" class="service-input" type="number" min="1" required />
            </label>
            <button type="submit" class="services-btn services-btn-primary">Añadir repuesto</button>
        </form>
        <span asp-validation-for="ProductoId" class="service-validation"></span><span asp-validation-for="Cantidad" class="service-validation"></span>
    </section>

    <section class="recent-orders ordenes-card">
        <div class="ordenes-titulo-seccion"><span class="ordenes-paso">3</span><div><h2>Resumen de la orden <span class="ordenes-conteo">@Model.Lineas.Count @(Model.Lineas.Count == 1 ? "repuesto" : "repuestos")</span></h2><p>Revisa los conceptos y el total estimado antes de guardar.</p></div></div>
        <div class="ordenes-servicios-resumen" aria-live="polite">
            <h3>Servicios incluidos <span id="orden-servicios-cantidad">@Model.ServiciosSeleccionados.Count</span></h3>
            @if (Model.ServiciosSeleccionados.Count == 0)
            {
                <p id="orden-servicios-vacio">Agrega uno o más servicios para completar la orden.</p>
            }
            else
            {
                <ul id="orden-servicios-resumen-lista">
                    @foreach (var servicio in Model.ServiciosSeleccionados)
                    {
                        <li data-servicio-resumen="@servicio.Id"><span>@servicio.Nombre</span><strong>Bs. @servicio.Costo.ToString("0.00")</strong></li>
                    }
                </ul>
            }
        </div>
        @if (Model.Lineas.Count == 0) { <div class="ordenes-vacio-detalle"><span aria-hidden="true">＋</span><p><strong>Aún no hay repuestos</strong><br />Puedes guardar la orden solo con un servicio.</p></div> }
        else
        {
            <div class="table-container">
                <table class="orders-table services-table">
                    <thead><tr><th>Código</th><th>Producto</th><th>Precio unitario</th><th>Cantidad</th><th>Subtotal</th><th>Acciones</th></tr></thead>
                    <tbody>
                    @foreach (var linea in Model.Lineas)
                    {
                        <tr data-orden-linea data-precio="@linea.Precio.ToString(CultureInfo.InvariantCulture)">
                            <td>@linea.Codigo</td>
                            <td>@linea.Nombre @if (linea.Cantidad > linea.Stock) { <span class="service-validation">Stock insuficiente; se comprobará al guardar.</span> }</td>
                            <td>Bs. @linea.Precio.ToString("0.00")</td>
                            <td>
                                <form method="post" asp-page-handler="ActualizarCantidad" class="ordenes-editar">
                                    <partial name="_ContextoNuevaOrden" model="Model" />
                                    <input type="hidden" name="productoId" value="@linea.ProductoId" />
                                    <input type="number" name="cantidad" value="@linea.Cantidad" min="1" data-cantidad required aria-label="Cantidad de @linea.Nombre" />
                                    <button class="services-btn services-btn-secondary">Actualizar</button>
                                </form>
                            </td>
                            <td data-subtotal>Bs. @((linea.Precio * linea.Cantidad).ToString("0.00"))</td>
                            <td>
                                <form method="post" asp-page-handler="QuitarLinea">
                                    <partial name="_ContextoNuevaOrden" model="Model" />
                                    <input type="hidden" name="productoId" value="@linea.ProductoId" />
                                    <button class="services-btn services-btn-secondary">Quitar</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="2">Resumen (<span id="resumen-lineas">@Model.Lineas.Count</span> líneas)</th>
                            <th colspan="2"><span id="resumen-cantidad">@Model.CantidadTotal</span> unidades</th>
                            <th id="resumen-total" data-costo-servicio="@Model.CostoServiciosSeleccionados.ToString(CultureInfo.InvariantCulture)">Bs. @Model.TotalEstimado.ToString("0.00")</th><th></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
        <div class="ordenes-guardar">
            <span class="ordenes-total-estimado">Total estimado <strong data-total-estimado>Bs. @Model.TotalEstimado.ToString("0.00")</strong></span>
            <span asp-validation-for="Formulario.Lineas" class="service-validation"></span>
            <span asp-validation-for="Formulario.ServicioIds" class="service-validation"></span>
            <button type="submit" form="formulario-orden" class="services-btn services-btn-primary">✓ Guardar orden</button>
        </div>
    </section>

</div>

<dialog id="confirmar-orden-dialog" class="orden-confirmacion-dialog"
        aria-labelledby="confirmar-orden-titulo" aria-describedby="confirmar-orden-descripcion">
    <div class="orden-confirmacion-cabecera">
        <span class="orden-confirmacion-icono" aria-hidden="true">✓</span>
        <div>
            <h2 id="confirmar-orden-titulo">Confirmar orden</h2>
            <p id="confirmar-orden-descripcion">Revisa los datos antes de registrar esta orden.</p>
        </div>
    </div>
    <p class="orden-confirmacion-mensaje">
        Al confirmar, se guardará la orden y podrás consultar el comprobante en esta misma página.
    </p>
    <div class="orden-confirmacion-acciones">
        <button type="button" class="services-btn services-btn-secondary" data-cancelar-confirmacion>
            Seguir revisando
        </button>
        <button type="button" class="services-btn services-btn-primary" data-confirmar-orden>
            Confirmar y guardar
        </button>
    </div>
</dialog>

@section Styles {
    <link rel="stylesheet" href="~/css/autocompletado.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nueva-orden.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/autocompletado.js" asp-append-version="true"></script>
    <script src="~/js/ordenes.js" asp-append-version="true"></script>
    <script src="~/js/nueva-orden.js" asp-append-version="true"></script>
    <script src="~/js/orden-comprobante.js" asp-append-version="true"></script>
}
