@page
@model IndexModel
@inject TallerMecanico.Infraestructura.Configuracion.ConfiguracionTaller configuracion

@{
    ViewData["Title"] = "Inicio";
}

<div class="home">
    <section class="home-hero">
        <div class="home-hero-overlay"></div>
        <div class="home-hero-content">
            <h1>Potencia la eficiencia de tu taller mecánico</h1>
            <p>Centraliza el registro de vehículos, optimiza la carga laboral de tus especialistas y mantén un control absoluto sobre tu catálogo de servicios</p>
        </div>
    </section>

    <section class="home-features">
        <a class="home-card" asp-page="/Vehiculos/Index">
            <div class="home-card-icon">🚗</div>
            <h2>Gestión de Vehículos</h2>
            <p>Registro clínico de cada vehículo: ficha completa, historial y seguimiento centralizado.</p>
        </a>

        <a class="home-card" asp-page="/Mecanicos/Index">
            <div class="home-card-icon">👨‍🔧</div>
            <h2>Especialistas en Acción</h2>
            <p>Asignación y control de la carga laboral de tus mecánicos especialistas.</p>
        </a>

        <a class="home-card" asp-page="/Servicios/Index">
            <div class="home-card-icon">📋</div>
            <h2>Catálogo de Servicios</h2>
            <p>Estandarización de costos y tiempos para cada servicio del taller.</p>
        </a>
    </section>

    <div class="dashboard">
        <div class="dashboard-header">
            <div>
                <h1>Dashboard</h1>
                <p>Resumen general del taller mecánico — Vista: @(User.IsInRole("Administrador") ? "Administrador" : "Recepcionista")</p>
            </div>

            <div class="dashboard-date">
                <span>Hoy</span>
                <strong>@DateTime.Now.ToString(configuracion.FormatoFecha)</strong>
            </div>

            <div class="dashboard-date" title="Identificador real del contenedor que atendió esta solicitud">
                <span>Réplica activa</span>
                <strong>@System.Environment.MachineName</strong>
            </div>
        </div>

        <div class="metrics-grid">
            <div class="metric-card">
                <div class="metric-icon">👨‍🔧</div>
                <div class="metric-info">
                    <span class="metric-label">Mecánicos disponibles</span>
                    <strong class="metric-value">@Model.Dashboard.MecanicosDisponibles</strong>
                </div>
            </div>

            <div class="metric-card">
                <div class="metric-icon">🚗</div>
                <div class="metric-info">
                    <span class="metric-label">Vehículos registrados</span>
                    <strong class="metric-value">@Model.Dashboard.VehiculosRegistrados</strong>
                </div>
            </div>

            <div class="metric-card">
                <div class="metric-icon">🔧</div>
                <div class="metric-info">
                    <span class="metric-label">Servicios registrados</span>
                    <strong class="metric-value">@Model.Dashboard.ServiciosRegistrados</strong>
                </div>
            </div>
        </div>

        @if (Model.Cache is not null)
        {
            var (estadoCache, claseCache) = Model.Cache.Estado switch
            {
                TallerMecanico.Aplicacion.Dto.EstadoCache.Hit => ("HIT", "cache-estado-hit"),
                TallerMecanico.Aplicacion.Dto.EstadoCache.Miss => ("MISS", "cache-estado-miss"),
                TallerMecanico.Aplicacion.Dto.EstadoCache.Deshabilitado => ("DESHABILITADO", "cache-estado-no-disponible"),
                TallerMecanico.Aplicacion.Dto.EstadoCache.EntradaInvalida => ("DATOS INVÁLIDOS", "cache-estado-no-disponible"),
                _ => ("NO DISPONIBLE", "cache-estado-no-disponible")
            };

            <div class="cache-panel" title="Origen de los datos del dashboard (Redis compartido entre réplicas)">
                <span class="cache-estado @claseCache">Cache: @estadoCache</span>
                @if (Model.Cache.Almacenado == false)
                {
                    <span>No se pudo guardar el resumen en caché; se muestran datos de MySQL.</span>
                }
                @if (Model.Cache.Estado == TallerMecanico.Aplicacion.Dto.EstadoCache.NoDisponible)
                {
                    <span>Falló la lectura de caché; se muestran datos de MySQL.</span>
                }
                @if (Model.Cache.Almacenado == true && Model.Cache.Estado != TallerMecanico.Aplicacion.Dto.EstadoCache.Miss)
                {
                    <span>Resumen guardado en caché para próximas consultas.</span>
                }
                <span>Generado por: <strong>@Model.Cache.ReplicaOrigen</strong></span>
                <span>Atendido por: <strong>@Model.Cache.ReplicaActual</strong></span>
                <span>Generado: <strong>@Model.Cache.GeneradoEn.ToString(configuracion.FormatoFecha + " HH:mm:ss")</strong></span>
                @if (Model.Cache.TiempoRestante is TimeSpan restante)
                {
                    <span>Expira en: <strong>@Math.Ceiling(restante.TotalSeconds) s</strong></span>
                }

                @if (User.IsInRole("Administrador"))
                {
                    <form method="post" asp-page-handler="InvalidarCache" class="cache-form">
                        <button type="submit" class="cache-boton">Invalidar caché</button>
                    </form>
                }
            </div>

            @if (!string.IsNullOrEmpty(Model.MensajeCache))
            {
                <p class="cache-mensaje">@Model.MensajeCache</p>
            }
        }
    </div>

    @if (User.IsInRole("Administrador"))
    {
        <section class="home-audit">
            <div class="home-audit-content">
                <h2>Auditoría de Costos en Tiempo Real</h2>
                <p>El sistema rastrea cada modificación de precios de servicios para garantizar transparencia total en tu taller.</p>
                <a class="home-audit-link" asp-page="/Historial/Index">Ver historial de cambios</a>
            </div>
        </section>
    }

    <footer class="home-footer">
        <span>@configuracion.NombreTaller - @configuracion.Version</span>
    </footer>
</div>
