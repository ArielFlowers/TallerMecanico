@page
@model TallerMecanico.Pages.Vehiculos.IndexModel
@using TallerMecanico.Models
@using TallerMecanico.Validators

@{
    ViewData["Title"] = "Vehículos";
}

<div class="dashboard">

    <div class="dashboard-header">

        <div>
            <h1>Gestión de Vehículos</h1>
            <p>
                Administra y registra los vehículos del taller.
            </p>
        </div>

        <div class="services-actions">

            <partial name="_BuscadorVehiculo"
                     model="Model.Buscar" />

            <a asp-page="./Index"
               class="services-btn services-btn-secondary">
                Refrescar
            </a>

            <button type="button"
                    class="services-btn services-btn-primary"
                    data-modal-abrir="modal-crear">
                + Nuevo Registro
            </button>

        </div>

    </div>


    <section class="recent-orders">

        <div class="section-header">
            <div>
                <h2>
                    Vehículos Registrados
                    (@Model.Vehiculos.Count)
                </h2>
            </div>
        </div>


        @if (Model.Vehiculos.Count == 0)
        {
            <div class="services-empty">

                <div class="services-empty-icon">
                    🚗
                </div>

                <strong>
                    No existen vehículos registrados
                </strong>

                <span>
                    Registra un nuevo vehículo para comenzar a llevar el control.
                </span>

            </div>
        }
        else
        {
            <div class="table-container">

                <table class="orders-table services-table vehiculos-table">

                    <thead>
                        <tr>
                            <th>Placa</th>
                            <th>Marca</th>
                            <th>Modelo</th>
                            <th>Cliente</th>
                            <th>Kilometraje</th>
                            <th>Observaciones</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var vehiculo in Model.Vehiculos)
                        {
                            <tr>

                                <td class="service-name">
                                    @vehiculo.Placa
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(vehiculo.Marca)
                                        ? "Pendiente"
                                        : vehiculo.Marca)
                                </td>

                                <td>
                                    @vehiculo.Modelo
                                </td>

                                <td>
                                    @if (vehiculo.ClienteId.HasValue)
                                    {
                                        <strong>
                                            @Model.ObtenerNombreCliente(
                                                vehiculo.ClienteId)
                                        </strong>

                                        <div style="
                                            font-size: 12px;
                                            opacity: .7;
                                            margin-top: 3px;">
                                            CI:
                                            @Model.ObtenerCiCliente(
                                                vehiculo.ClienteId.Value)
                                        </div>
                                    }
                                    else
                                    {
                                        <span style="opacity: .65;">
                                            Sin cliente asignado
                                        </span>
                                    }
                                </td>

                                <td>
                                    @vehiculo.Kilometraje km
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(
                                        vehiculo.Observaciones)
                                        ? "-"
                                        : vehiculo.Observaciones)
                                </td>

                                <td>

                                    <div class="services-row-actions">

                                        <button type="button"
                                                class="service-action service-action-icon service-action-edit"
                                                title="Editar vehículo"
                                                data-modal-abrir="modal-editar"
                                                data-id="@vehiculo.Id"
                                                data-placa="@vehiculo.Placa"
                                                data-marca="@vehiculo.Marca"
                                                data-modelo="@vehiculo.Modelo"
                                                data-kilometraje="@vehiculo.Kilometraje"
                                                data-observaciones="@vehiculo.Observaciones"
                                                data-cliente-id="@(vehiculo.ClienteId?.ToString() ?? string.Empty)">
                                            ✎
                                        </button>

                                        <button type="button"
                                                class="service-action service-action-icon service-action-delete"
                                                title="Eliminar vehículo"
                                                data-modal-abrir="modal-eliminar"
                                                data-id="@vehiculo.Id"
                                                data-placa="@vehiculo.Placa">
                                            🗑
                                        </button>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </section>

</div>


<!-- ================================================= -->
<!-- MODAL: REGISTRAR NUEVO VEHÍCULO                  -->
<!-- ================================================= -->

<div id="modal-crear"
     class="modal-overlay @(Model.ModalAbierto == "crear" ? "is-open" : "")">

    <div class="modal-dialog">

        <div class="service-form-header">

            <div>
                <h2>
                    Registrar Nuevo Vehículo
                </h2>

                <p>
                    Completa los datos para registrar un nuevo vehículo.
                </p>
            </div>

            <button type="button"
                    class="modal-close"
                    data-modal-cerrar>
                &times;
            </button>

        </div>


        <form method="post"
              asp-page-handler="Create"
              class="service-form">

            <div asp-validation-summary="ModelOnly"
                 class="service-validation">
            </div>


            <!-- CLIENTE -->

            <div class="service-form-group">

                <label for="crear-cliente">
                    Cliente
                </label>

                <select asp-for="Formulario.ClienteId"
                        id="crear-cliente"
                        class="service-input">

                    <option value="">
                        Sin cliente asignado
                    </option>

                    @foreach (var cliente in Model.Clientes)
                    {
                        <option value="@cliente.Id">
                            @cliente.Ci@(string.IsNullOrWhiteSpace(cliente.ComplementoCi) ? "" : $"-{cliente.ComplementoCi}") -
                            @cliente.Nombres
                            @cliente.PrimerApellido
                            @cliente.SegundoApellido
                        </option>
                    }

                </select>

                <span asp-validation-for="Formulario.ClienteId"
                      class="service-validation">
                </span>

                @if (Model.Clientes.Count == 0)
                {
                    <small style="display:block; margin-top:6px;">
                        No hay clientes registrados.
                        Puedes guardar el vehículo sin cliente y asignarlo posteriormente.
                    </small>
                }

            </div>


            <!-- PLACA -->

            <div class="service-form-group">

                <label for="crear-placa">
                    Placa
                    <span class="campo-obligatorio">*</span>
                </label>

                <input asp-for="Formulario.Placa"
                       id="crear-placa"
                       class="service-input"
                       maxlength="7"
                       required
                       pattern="@ValidacionVehiculos.PatronPlaca"
                       data-placa-mensaje="@ValidacionVehiculos.MensajeFormatoPlaca"
                       placeholder="Ej. 123ABC o 1234ABC"
                       data-placa-input />

                <span class="field-warning"
                      data-placa-aviso>
                </span>

                <span asp-validation-for="Formulario.Placa"
                      class="service-validation">
                </span>

            </div>


            <!-- MARCA -->

            <div class="service-form-group">

                <label for="crear-marca">
                    Marca
                    <span class="campo-obligatorio">*</span>
                </label>

                <select asp-for="Formulario.Marca"
                        id="crear-marca"
                        class="service-input"
                        required
                        data-marca-input>

                    <option value="">
                        Selecciona una marca
                    </option>

                    @foreach (var marca in
                              CatalogoVehiculos.Marcas.Keys)
                    {
                        <option value="@marca">
                            @marca
                        </option>
                    }

                </select>

                <span asp-validation-for="Formulario.Marca"
                      class="service-validation">
                </span>

            </div>


            <!-- MODELO -->

            <div class="service-form-group">

                <label for="crear-modelo">
                    Modelo
                    <span class="campo-obligatorio">*</span>
                </label>

                <select asp-for="Formulario.Modelo"
                        id="crear-modelo"
                        class="service-input"
                        required
                        data-modelo-input>

                    <option value="">
                        Selecciona un modelo
                    </option>

                    @if (CatalogoVehiculos.Marcas.TryGetValue(
                            Model.Formulario.Marca ??
                            string.Empty,
                            out var modelosCrear))
                    {
                        @foreach (var modelo in modelosCrear)
                        {
                            <option value="@modelo">
                                @modelo
                            </option>
                        }
                    }

                </select>

                <span asp-validation-for="Formulario.Modelo"
                      class="service-validation">
                </span>

            </div>


            <!-- KILOMETRAJE -->

            <div class="service-form-group">

                <label for="crear-kilometraje">
                    Kilometraje
                </label>

                <input asp-for="Formulario.Kilometraje"
                       id="crear-kilometraje"
                       class="service-input"
                       type="number"
                       min="0"
                       placeholder="Ej. 45000" />

                <span asp-validation-for="Formulario.Kilometraje"
                      class="service-validation">
                </span>

            </div>


            <!-- OBSERVACIONES -->

            <div class="service-form-group">

                <label for="crear-observaciones">
                    Observaciones
                </label>

                <textarea asp-for="Formulario.Observaciones"
                          id="crear-observaciones"
                          class="service-input service-textarea"
                          rows="3"
                          placeholder="Detalles adicionales del estado del vehículo..."></textarea>

                <span asp-validation-for="Formulario.Observaciones"
                      class="service-validation">
                </span>

            </div>


            <div class="service-form-actions">

                <button type="button"
                        class="services-btn services-btn-secondary"
                        data-modal-cerrar>
                    Cancelar
                </button>

                <button type="submit"
                        class="services-btn services-btn-primary">
                    Guardar
                </button>

            </div>

        </form>

    </div>

</div>


<!-- ================================================= -->
<!-- MODAL: EDITAR VEHÍCULO                           -->
<!-- ================================================= -->

<div id="modal-editar"
     class="modal-overlay @(Model.ModalAbierto == "editar" ? "is-open" : "")">

    <div class="modal-dialog">

        <div class="service-form-header">

            <div>
                <h2>
                    Editar Vehículo
                </h2>

                <p>
                    Modifica los datos del vehículo y guarda los cambios.
                </p>
            </div>

            <button type="button"
                    class="modal-close"
                    data-modal-cerrar>
                &times;
            </button>

        </div>


        <form method="post"
              asp-page-handler="Update"
              class="service-form">

            <div asp-validation-summary="ModelOnly"
                 class="service-validation">
            </div>

            <input asp-for="Formulario.Id"
                   id="editar-id"
                   type="hidden" />


            <!-- CLIENTE -->

            <div class="service-form-group">

                <label for="editar-cliente">
                    Cliente
                </label>

                <select asp-for="Formulario.ClienteId"
                        id="editar-cliente"
                        class="service-input">

                    <option value="">
                        Sin cliente asignado
                    </option>

                    @foreach (var cliente in Model.Clientes)
                    {
                        <option value="@cliente.Id">
                            @cliente.Ci@(string.IsNullOrWhiteSpace(cliente.ComplementoCi) ? "" : $"-{cliente.ComplementoCi}") -
                            @cliente.Nombres
                            @cliente.PrimerApellido
                            @cliente.SegundoApellido
                        </option>
                    }

                </select>

                <span asp-validation-for="Formulario.ClienteId"
                      class="service-validation">
                </span>

                <small style="
                    display:block;
                    margin-top:6px;
                    opacity:.7;">
                    Los vehículos antiguos sin cliente pueden asignarse desde aquí.
                </small>

            </div>


            <!-- PLACA -->

            <div class="service-form-group">

                <label for="editar-placa">
                    Placa
                    <span class="campo-obligatorio">*</span>
                </label>

                <input asp-for="Formulario.Placa"
                       id="editar-placa"
                       class="service-input"
                       maxlength="7"
                       required
                       pattern="@ValidacionVehiculos.PatronPlaca"
                       data-placa-mensaje="@ValidacionVehiculos.MensajeFormatoPlaca"
                       data-placa-input />

                <span class="field-warning"
                      data-placa-aviso>
                </span>

                <span asp-validation-for="Formulario.Placa"
                      class="service-validation">
                </span>

            </div>


            <!-- MARCA -->

            <div class="service-form-group">

                <label for="editar-marca">
                    Marca
                    <span class="campo-obligatorio">*</span>
                </label>

                <select asp-for="Formulario.Marca"
                        id="editar-marca"
                        class="service-input"
                        required
                        data-marca-input>

                    <option value="">
                        Selecciona una marca
                    </option>

                    @foreach (var marca in
                              CatalogoVehiculos.Marcas.Keys)
                    {
                        <option value="@marca">
                            @marca
                        </option>
                    }

                </select>

                <span asp-validation-for="Formulario.Marca"
                      class="service-validation">
                </span>

            </div>


            <!-- MODELO -->

            <div class="service-form-group">

                <label for="editar-modelo">
                    Modelo
                    <span class="campo-obligatorio">*</span>
                </label>

                <select asp-for="Formulario.Modelo"
                        id="editar-modelo"
                        class="service-input"
                        required
                        data-modelo-input>

                    <option value="">
                        Selecciona un modelo
                    </option>

                    @if (CatalogoVehiculos.Marcas.TryGetValue(
                            Model.Formulario.Marca ??
                            string.Empty,
                            out var modelosEditar))
                    {
                        @foreach (var modelo in modelosEditar)
                        {
                            <option value="@modelo">
                                @modelo
                            </option>
                        }
                    }

                </select>

                <span asp-validation-for="Formulario.Modelo"
                      class="service-validation">
                </span>

                <p id="editar-modelo-anterior"
                   hidden="@(string.IsNullOrEmpty(Model.ModeloAnterior))">
                    Modelo anterior:
                    <span>
                        @Model.ModeloAnterior
                    </span>.
                    Selecciona una marca y un modelo del catálogo.
                </p>

            </div>


            <!-- KILOMETRAJE -->

            <div class="service-form-group">

                <label for="editar-kilometraje">
                    Kilometraje
                </label>

                <input asp-for="Formulario.Kilometraje"
                       id="editar-kilometraje"
                       class="service-input"
                       type="number"
                       min="0" />

                <span asp-validation-for="Formulario.Kilometraje"
                      class="service-validation">
                </span>

            </div>


            <!-- OBSERVACIONES -->

            <div class="service-form-group">

                <label for="editar-observaciones">
                    Observaciones
                </label>

                <textarea asp-for="Formulario.Observaciones"
                          id="editar-observaciones"
                          class="service-input service-textarea"
                          rows="3"></textarea>

                <span asp-validation-for="Formulario.Observaciones"
                      class="service-validation">
                </span>

            </div>


            <div class="service-form-actions">

                <button type="button"
                        class="services-btn services-btn-secondary"
                        data-modal-cerrar>
                    Cancelar
                </button>

                <button type="submit"
                        class="services-btn services-btn-primary">
                    Guardar
                </button>

            </div>

        </form>

    </div>

</div>


<!-- ================================================= -->
<!-- MODAL: ELIMINAR VEHÍCULO                         -->
<!-- ================================================= -->

<div id="modal-eliminar"
     class="modal-overlay">

    <div class="modal-dialog">

        <div class="service-form-header">

            <div>
                <h2>
                    Eliminar Vehículo
                </h2>

                <p>
                    Confirma la eliminación del vehículo seleccionado.
                </p>
            </div>

            <button type="button"
                    class="modal-close"
                    data-modal-cerrar>
                &times;
            </button>

        </div>


        <form method="post"
              asp-page-handler="Delete"
              class="service-form">

            <input type="hidden"
                   name="id"
                   id="eliminar-id" />

            <div class="service-delete-warning">

                <strong id="eliminar-placa">
                </strong>

                <span>
                    Se eliminará este vehículo del taller y no se podrá deshacer.
                </span>

            </div>


            <div class="service-form-actions">

                <button type="button"
                        class="services-btn services-btn-secondary"
                        data-modal-cerrar>
                    Cancelar
                </button>

                <button type="submit"
                        class="services-btn services-btn-danger">
                    Eliminar
                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <script id="catalogo-vehiculos"
            type="application/json">
        @Html.Raw(
            System.Text.Json.JsonSerializer.Serialize(
                CatalogoVehiculos.Marcas))
    </script>

    <script src="~/js/vehiculos.js"
            asp-append-version="true">
    </script>

    <script>
        (() => {

            const selectorClienteEditar =
                document.getElementById(
                    "editar-cliente");

            document
                .querySelectorAll(
                    '[data-modal-abrir="modal-editar"]'
                )
                .forEach(boton => {

                    boton.addEventListener(
                        "click",
                        () => {

                            if (!selectorClienteEditar) {
                                return;
                            }

                            selectorClienteEditar.value =
                                boton.dataset.clienteId ?? "";

                        });

                });

        })();
    </script>
}