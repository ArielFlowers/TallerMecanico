@page
@model TallerMecanico.Pages.Auth.ActivarInvitacionModel

@{
    ViewData["Title"] = "Activar Invitación - AutoTaller Pro";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />

    <title>Activar Invitación | AutoTaller Pro</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            padding: 24px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: "Segoe UI", sans-serif;
            background: #0d0a12;
            color: #f5f3ff;
        }

        .activation-card {
            width: 100%;
            max-width: 520px;
            padding: 46px;
            text-align: center;
            background: #171120;
            border: 1px solid #342643;
            border-radius: 20px;
            box-shadow: 0 24px 70px rgba(0, 0, 0, 0.35);
        }

        .activation-icon {
            width: 74px;
            height: 74px;
            margin: 0 auto 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #7c3aed;
            border-radius: 20px;
            font-size: 34px;
        }

        h1 {
            margin: 0 0 18px;
            font-size: 28px;
        }

        p {
            color: #b7a8c8;
            line-height: 1.7;
        }

        .message {
            margin: 20px 0;
            padding: 16px;
            background: #291b3e;
            border: 1px solid #63418f;
            border-radius: 10px;
            color: #e9ddff;
        }

        .message.success {
            background: #103126;
            border-color: #287752;
            color: #b8f7d5;
        }

        .message.error {
            background: #3a1a1a;
            border-color: #7a2a2a;
            color: #fca5a5;
        }

        .form-group {
            margin-bottom: 19px;
            text-align: left;
        }

        .form-group label {
            display: block;
            margin-bottom: 9px;
            font-size: 14px;
            font-weight: 600;
        }

        .form-control {
            width: 100%;
            padding: 13px 14px;
            color: #fff;
            background: #21192c;
            border: 1px solid #463653;
            border-radius: 9px;
            font-size: 15px;
            outline: none;
        }

        .form-control:focus {
            border-color: #8b5cf6;
            box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.18);
        }

        .validation-error {
            display: block;
            margin-top: 6px;
            color: #fca5a5;
            font-size: 13px;
        }

        .activate-button {
            display: block;
            width: 100%;
            padding: 15px;
            margin-top: 25px;
            border: none;
            border-radius: 10px;
            background: #7c3aed;
            color: #ffffff;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
        }

        .activate-button:hover {
            background: #6d28d9;
        }

        .back-link {
            display: inline-block;
            margin-top: 28px;
            color: #b99bff;
            text-decoration: none;
        }

        .back-link:hover {
            text-decoration: underline;
        }

        @@media (max-width: 600px) {
            .activation-card {
                padding: 28px 22px;
            }

            h1 {
                font-size: 24px;
            }
        }
    </style>
</head>
<body>
    <main class="activation-card">
        <div class="activation-icon" aria-hidden="true">
            🔐
        </div>

        <h1>Activar Invitación</h1>

        @if (!Model.TokenValido && !Model.Activado)
        {
            <div class="message error" role="status">
                @Model.Mensaje
            </div>

            <a class="back-link" asp-page="/Auth/Login">
                Volver al inicio de sesión
            </a>
        }
        else if (Model.Activado)
        {
            <div class="message success" role="status">
                @Model.Mensaje
            </div>

            <a class="back-link" asp-page="/Auth/Login">
                Iniciar sesión
            </a>
        }
        else
        {
            <p>
                Establezca su contraseña para activar su cuenta en AutoTaller Pro.
            </p>

            <form method="post">
                <input type="hidden" asp-for="Input.Token" />

                <div class="form-group">
                    <label asp-for="Input.Password">Contraseña</label>
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Input.Password" class="validation-error"></span>
                    <div style="margin-top: 6px; font-size: 13px; color: #9384a4;">
                        Mínimo 12 caracteres.
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Input.ConfirmPassword">Confirmar contraseña</label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="validation-error"></span>
                </div>

                <button type="submit" class="activate-button">
                    Activar Cuenta
                </button>
            </form>
        }
    </main>

    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>