@page
@model TallerMecanico.Pages.Auth.ReenviarVerificacionModel

@{
    Layout = null;
    ViewData["Title"] = "Reenviar verificacion";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Reenviar verificacion | AutoTaller Pro</title>
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            background: #0d0912;
            color: #fff;
            font-family: Arial, sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }
        .panel {
            width: 100%;
            max-width: 490px;
            padding: 40px;
            background: #191121;
            border: 1px solid #39264d;
            border-radius: 20px;
        }
        .icono {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 65px;
            height: 65px;
            background: #7c3aed;
            border-radius: 18px;
            font-size: 30px;
        }
        h1 { font-size: 26px; margin: 22px 0 12px; }
        p { color: #c9b8dc; line-height: 1.65; }
        label { display: block; margin: 24px 0 10px; font-weight: bold; }
        input {
            width: 100%;
            padding: 14px;
            border-radius: 9px;
            background: #261a32;
            border: 1px solid #5d4478;
            color: #fff;
            font-size: 15px;
        }
        input:focus-visible, button:focus-visible, a:focus-visible {
            outline: 3px solid #b794f4;
            outline-offset: 3px;
        }
        button {
            width: 100%;
            margin-top: 20px;
            padding: 15px;
            border: 0;
            border-radius: 9px;
            background: #7c3aed;
            color: #fff;
            font-size: 15px;
            font-weight: bold;
            cursor: pointer;
        }
        button:hover { background: #6d28d9; }
        .mensaje {
            padding: 17px;
            border: 1px solid #7659a0;
            border-radius: 9px;
            background: #2a1d37;
            line-height: 1.6;
        }
        .error { color: #ffb3bd; display: block; margin-top: 8px; }
        .volver { display: block; text-align: center; margin-top: 25px; }
        a { color: #c4a0ff; }
    </style>
</head>
<body>
    <main class="panel">
        <div class="icono" aria-hidden="true">✉</div>

        <h1>Reenviar verificacion</h1>

        @if (Model.SolicitudRecibida)
        {
            <div class="mensaje" role="status">
                Si existe una solicitud pendiente para ese correo
                y es posible reenviar el enlace, recibiras un
                mensaje de verificacion.
                Revisa tambien la carpeta de spam.
            </div>
        }
        else
        {
            <p>
                ¿No recibiste el correo? Ingresa la direccion que
                utilizaste al registrarte para solicitar otro enlace.
            </p>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="error"></div>

                <label asp-for="Email">Correo electronico</label>

                <input asp-for="Email"
                       type="email"
                       autocomplete="email"
                       maxlength="254"
                       required />

                <span asp-validation-for="Email" class="error"></span>

                <button type="submit">
                    Solicitar nuevo enlace
                </button>
            </form>
        }

        <a class="volver" asp-page="/Auth/Login">
            Volver al inicio de sesion
        </a>
    </main>
</body>
</html>