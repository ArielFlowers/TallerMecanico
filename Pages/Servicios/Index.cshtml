@page
@model TallerMecanico.Pages.Servicios.IndexModel
@using TallerMecanico.Aplicacion.Dto
@using TallerMecanico.Pages.Shared

@{
    ViewData["Title"] = "Gestión de Servicios";

    ServicioTablaViewModel tablaModel = new()
    {
        Servicios = Model.Servicios,
        MostrarAcciones = true
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/autocompletado.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/servicios.css" asp-append-version="true" />
}

<div class="dashboard">
    <div class="dashboard-header">
        <div>
            <h1>Gestión de Servicios</h1>
            <p>Consulta y administra los servicios registrados.</p>
        </div>

        <a asp-page="./Create"
           class="services-btn services-btn-primary">
            + Nuevo Servicio
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.MensajeError))
    {
        <div class="service-validation-summary" role="alert">
            @Model.MensajeError
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.MensajeExito))
    {
        <div class="service-validation-summary" role="status">
            @Model.MensajeExito
        </div>
    }

    <div class="services-actions servicios-toolbar">
        <form method="get"
              asp-page="./Index"
              class="buscador services-actions servicios-search"
              id="servicios-busqueda"
              role="search">

            <partial name="_BuscadorAutocompletado" model='new BuscadorAutocompletadoModel
            {
                Id = "servicios-autocompletado",
                UrlSugerencias = Url.Page("./Index", "Sugerencias")!,
                Modo = BuscadorAutocompletadoModel.ModoFiltrar,
                Etiqueta = "Buscar servicios",
                Placeholder = "Buscar por nombre o descripción...",
                NombreCampoTexto = "buscar",
                NombreCampoId = nameof(Model.ServicioSeleccionadoId),
                Texto = Model.Busqueda,
                IdSeleccionado = Model.ServicioSeleccionadoId
            }' />

            <button type="submit" class="services-btn services-btn-secondary">Buscar</button>

            @if (!string.IsNullOrWhiteSpace(Model.Busqueda) || Model.ServicioSeleccionadoId.HasValue)
            {
                <a asp-page="./Index" class="services-btn services-btn-secondary">Limpiar</a>
            }
        </form>

        <a asp-page="./Index" class="services-btn services-btn-secondary">Refrescar</a>
    </div>

    <section class="recent-orders">
        <div class="section-header">
            <div>
                <h2>Servicios registrados</h2>
                <p>@Model.Servicios.Count servicio(s) encontrados</p>
            </div>
        </div>

        <partial name="_TablaServicios"
                 model="tablaModel" />
    </section>
</div>
@section Scripts {
    <script src="~/js/autocompletado.js" asp-append-version="true"></script>
    <script>
        document.getElementById('servicios-autocompletado').addEventListener('autocompletado:seleccion', function () {
            document.getElementById('servicios-busqueda').requestSubmit();
        });
    </script>
}
