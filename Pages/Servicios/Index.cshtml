@page
@model TallerMecanico.Pages.Servicios.IndexModel

@{
    ViewData["Title"] = "Servicios";
}

<div class="dashboard">
    <div class="dashboard-header">
        <div>
            <h1>Servicios</h1>
            <p>Selecciona la operación que deseas realizar en el catálogo de servicios.</p>
        </div>
    </div>

    <section class="services-module">
        <div class="services-module-grid">

            <a asp-page="./Create"
               class="services-module-card">

                <div class="services-module-content">
                    <span class="services-module-label">
                        Registro
                    </span>

                    <h2>Nuevo servicio</h2>

                    <p>
                        Registra un nuevo servicio indicando nombre,
                        descripción, costo y tiempo estimado.
                    </p>
                </div>

                <div class="services-module-action">
                    Registrar servicio
                </div>
            </a>

            <a asp-page="./Registros"
               class="services-module-card">

                <div class="services-module-content">
                    <span class="services-module-label">
                        Consulta
                    </span>

                    <h2>Ver registros</h2>

                    <p>
                        Consulta los servicios actualmente almacenados
                        en el catálogo del taller.
                    </p>
                </div>

                <div class="services-module-action">
                    Consultar servicios
                </div>
            </a>

            <a asp-page="./Control"
               class="services-module-card">

                <div class="services-module-content">
                    <span class="services-module-label">
                        Administración
                    </span>

                    <h2>Control de registros</h2>

                    <p>
                        Administra los servicios registrados mediante
                        las opciones de edición y eliminación.
                    </p>
                </div>

                <div class="services-module-action">
                    Administrar servicios
                </div>
            </a>

        </div>
    </section>
</div>