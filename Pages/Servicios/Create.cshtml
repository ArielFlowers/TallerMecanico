@page
@model TallerMecanico.Pages.Servicios.CreateModel

@{
    ViewData["Title"] = "Nuevo Servicio";
}

<div class="dashboard">
    <div class="dashboard-header">
        <div>
            <h1>Nuevo Servicio</h1>
            <p>Registra un nuevo servicio en el catálogo del taller.</p>
        </div>

        <a asp-page="./Index"
           class="services-btn services-btn-secondary">
            Volver
        </a>
    </div>

    <section class="service-form-card">
        <div class="service-form-header">
            <h2>Datos del servicio</h2>
            <p>Completa la información requerida para registrar el servicio.</p>
        </div>

        <form method="post" class="service-form">
            <div asp-validation-summary="ModelOnly"
                 class="service-validation-summary">
            </div>

            <div class="service-form-group">
                <label asp-for="Formulario.Nombre">
                    Nombre
                </label>

                <input asp-for="Formulario.Nombre"
                       class="service-input"
                       placeholder="Ej. Cambio de aceite" />

                <span asp-validation-for="Formulario.Nombre"
                      class="service-validation">
                </span>
            </div>

            <div class="service-form-group">
                <label asp-for="Formulario.Descripcion">
                    Descripción
                </label>

                <textarea asp-for="Formulario.Descripcion"
                          class="service-input service-textarea"
                          rows="4"
                          placeholder="Describe brevemente el servicio"></textarea>

                <span asp-validation-for="Formulario.Descripcion"
                      class="service-validation">
                </span>
            </div>

            <div class="service-form-row">
                <div class="service-form-group">
                    <label asp-for="Formulario.Costo">
                        Costo (Bs.)
                    </label>

                    <input asp-for="Formulario.Costo"
                           class="service-input"
                           type="number"
                           step="0.01" />

                    <span asp-validation-for="Formulario.Costo"
                          class="service-validation">
                    </span>
                </div>

                <div class="service-form-group">
                    <label asp-for="Formulario.TiempoEstimadoHoras">
                        Tiempo estimado (horas)
                    </label>

                    <input asp-for="Formulario.TiempoEstimadoHoras"
                           class="service-input"
                           type="number"
                           step="0.01" />

                    <span asp-validation-for="Formulario.TiempoEstimadoHoras"
                          class="service-validation">
                    </span>
                </div>
            </div>

            <div class="service-form-actions">
                <a asp-page="./Index"
                   class="services-btn services-btn-secondary">
                    Cancelar
                </a>

                <button type="submit"
                        class="services-btn services-btn-primary">
                    Guardar Servicio
                </button>
            </div>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
