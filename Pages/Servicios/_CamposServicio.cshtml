@model TallerMecanico.Aplicacion.Dto.ServicioFormViewModel

<div class="service-form-group">
    <label asp-for="Nombre">
        Nombre
    </label>

    <input asp-for="Nombre"
           class="service-input"
           data-espacios-controlados
           placeholder="Ej. Cambio de aceite" />

    <span asp-validation-for="Nombre"
          class="service-validation">
    </span>
</div>

<div class="service-form-group">
    <label asp-for="Descripcion">
        Descripción
    </label>

    <textarea asp-for="Descripcion"
              class="service-input service-textarea"
              data-espacios-controlados
              rows="4"
              placeholder="Describe brevemente el servicio"></textarea>

    <span asp-validation-for="Descripcion"
          class="service-validation">
    </span>
</div>

<div class="service-form-row">
    <div class="service-form-group">
        <label asp-for="Costo">
            Costo por trabajo o unidad (Bs.)
        </label>

        <input asp-for="Costo"
               class="service-input"
               type="number"
               step="0.01"
               min="0.01" />

        <span asp-validation-for="Costo"
              class="service-validation">
        </span>
    </div>

    <div class="service-form-group">
        <label asp-for="TiempoEstimadoHoras">
            Tiempo estimado (horas)
        </label>

        <input asp-for="TiempoEstimadoHoras"
               class="service-input"
               type="number"
               step="0.01"
               min="0.01" />

        <span asp-validation-for="TiempoEstimadoHoras"
              class="service-validation">
        </span>
    </div>
</div>

<div class="service-form-group">
    <label asp-for="UnidadCantidad">Cobro por cantidad (opcional)</label>
    <select asp-for="UnidadCantidad" class="service-input">
        <option value="">Precio fijo por trabajo completo</option>
        <option value="llanta">Por llanta</option>
        <option value="retrovisor">Por retrovisor</option>
        <option value="unidad">Por unidad</option>
    </select>
    <small>Úsalo solo cuando el costo del servicio se cobre por cada pieza. Ejemplo: cambio de llanta.</small>
    <span asp-validation-for="UnidadCantidad" class="service-validation"></span>
</div>
