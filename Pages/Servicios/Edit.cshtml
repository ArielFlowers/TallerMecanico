@page
@model TallerMecanico.Pages.Servicios.EditModel

@{
    ViewData["Title"] = "Editar Servicio";
}

<div class="dashboard">
    <div class="dashboard-header">
        <div>
            <h1>Editar Servicio</h1>
            <p>Actualiza la información del servicio seleccionado.</p>
        </div>

        <a asp-page="./Control"
           class="services-btn services-btn-secondary">
            Volver
        </a>
    </div>

    <section class="service-form-card">
        <div class="service-form-header">
            <h2>Datos del servicio</h2>
            <p>Modifica los campos necesarios y guarda los cambios.</p>
        </div>

        <form method="post"
              asp-route-id="@Model.ServicioId"
              class="service-form">

            <div asp-validation-summary="ModelOnly"
                 class="service-validation-summary">
            </div>

            <partial name="_CamposServicio"
                     for="Formulario" />

            <div class="service-form-actions">
                <a asp-page="./Control"
                   class="services-btn services-btn-secondary">
                    Cancelar
                </a>

                <button type="submit"
                        class="services-btn services-btn-primary">
                    Guardar Cambios
                </button>
            </div>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
