@{
    bool esAdministrador = User.IsInRole("Administrador");
    bool esRecepcionista = User.IsInRole("Recepcionista");
    string nombreUsuario = User.Identity?.Name ?? "Usuario";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Taller Mecánico
    </title>

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    @await RenderSectionAsync(
        "Styles",
        required: false)
</head>

<body>

    <div class="app-container">

        <aside class="sidebar">

            <!-- MARCA -->

            <div class="brand">

                <div class="brand-icon">
                    🔧
                </div>

                <div class="brand-text">

                    <span class="brand-title">
                        TALLER
                    </span>

                    <span class="brand-subtitle">
                        MECÁNICO
                    </span>

                </div>

            </div>

            <nav class="sidebar-menu">

                <!-- INICIO -->

                <a class="menu-item @(Context.Request.Path == "/" ? "active" : "")"
                   asp-page="/Index">

                    <span class="menu-icon">
                        ⌂
                    </span>

                    <span>
                        Inicio
                    </span>

                </a>


                <!-- PERSONAL: SOLO ADMINISTRADOR -->
                @if (esAdministrador)
                {
                    <div class="menu-group">

                        <button class="menu-item menu-toggle"
                                type="button"
                                aria-expanded="false"
                                aria-controls="personal-menu">

                            <span class="menu-icon">
                                👤
                            </span>

                            <span>
                                Personal
                            </span>

                            <span class="menu-chevron">
                                ›
                            </span>

                        </button>

                        <div class="submenu"
                             id="personal-menu">

                            <a class="submenu-item @(Context.Request.Path.StartsWithSegments("/Mecanicos") ? "active" : "")"
                               asp-page="/Mecanicos/Index">

                                <span>
                                    Mecánicos
                                </span>

                            </a>

                            <!-- Pendiente: Gestión de usuarios -->
                            <a class="submenu-item"
                               href="#">

                                <span>
                                    Usuarios
                                </span>

                            </a>

                            <!-- Pendiente: Gestión de roles -->
                            <a class="submenu-item"
                               href="#">

                                <span>
                                    Roles
                                </span>

                            </a>

                        </div>

                    </div>
                }


                <!-- CLIENTES Y VEHÍCULOS: AMBOS ROLES -->

                <div class="menu-group">

                    <button class="menu-item menu-toggle"
                            type="button"
                            aria-expanded="false"
                            aria-controls="clientes-menu">

                        <span class="menu-icon">
                            👥
                        </span>

                        <span>
                            Clientes y Vehículos
                        </span>

                        <span class="menu-chevron">
                            ›
                        </span>

                    </button>

                    <div class="submenu"
                         id="clientes-menu">

                        <a class="submenu-item @(Context.Request.Path.StartsWithSegments("/Clientes") ? "active" : "")"
                           asp-page="/Clientes/Index">

                            <span>
                                Clientes
                            </span>

                        </a>

                        <a class="submenu-item @(Context.Request.Path.StartsWithSegments("/Vehiculos") ? "active" : "")"
                           asp-page="/Vehiculos/Index">

                            <span>
                                Vehículos
                            </span>

                        </a>

                    </div>

                </div>


                <!-- OPERACIONES DEL TALLER: AMBOS ROLES -->

                <div class="menu-group">

                    <button class="menu-item menu-toggle"
                            type="button"
                            aria-expanded="false"
                            aria-controls="taller-menu">

                        <span class="menu-icon">
                            🔧
                        </span>

                        <span>
                            Operaciones del Taller
                        </span>

                        <span class="menu-chevron">
                            ›
                        </span>

                    </button>

                    <div class="submenu"
                         id="taller-menu">

                        <!-- SERVICIOS: SOLO ADMINISTRADOR -->
                        @if (esAdministrador)
                        {
                            <a class="submenu-item @(Context.Request.Path.StartsWithSegments("/Servicios") ? "active" : "")"
                               asp-page="/Servicios/Index">

                                <span>
                                    Servicios
                                </span>

                            </a>
                        }

                        <!-- ÓRDENES: AMBOS ROLES -->
                        <!-- Enlace pendiente de implementar -->

                        <a class="submenu-item"
                           href="#">

                            <span>
                                Órdenes de trabajo
                            </span>

                        </a>

                        <!-- HISTORIAL: SOLO ADMINISTRADOR -->
                        @if (esAdministrador)
                        {
                            <a class="submenu-item @(Context.Request.Path.StartsWithSegments("/Historial") ? "active" : "")"
                               asp-page="/Historial/Index">

                                <span>
                                    Historial
                                </span>

                            </a>
                        }

                    </div>

                </div>


                <!-- INVENTARIO: AMBOS ROLES -->

                <div class="menu-group">

                    <button class="menu-item menu-toggle"
                            type="button"
                            aria-expanded="false"
                            aria-controls="inventario-menu">

                        <span class="menu-icon">
                            📦
                        </span>

                        <span>
                            Inventario
                        </span>

                        <span class="menu-chevron">
                            ›
                        </span>

                    </button>

                    <div class="submenu"
                         id="inventario-menu">

                        <a class="submenu-item @(Context.Request.Path.StartsWithSegments("/Productos") ? "active" : "")"
                           asp-page="/Productos/Index">

                            <span>
                                Productos
                            </span>

                        </a>

                        <!-- Enlace pendiente de implementar -->

                        <a class="submenu-item"
                           href="#">

                            <span>
                                Proveedores
                            </span>

                        </a>

                    </div>

                </div>


                <!-- ADMINISTRACIÓN: SOLO ADMINISTRADOR -->
                @if (esAdministrador)
                {
                    <div class="menu-group">

                        <button class="menu-item menu-toggle"
                                type="button"
                                aria-expanded="false"
                                aria-controls="administracion-menu">

                            <span class="menu-icon">
                                💼
                            </span>

                            <span>
                                Administración
                            </span>

                            <span class="menu-chevron">
                                ›
                            </span>

                        </button>

                        <div class="submenu"
                             id="administracion-menu">
                            <a class="submenu-item"
                               asp-page="/Administracion/Solicitudes">
                                <span>
                                    Aprobación de empleados
                                </span>
                            </a>

                            <!-- Enlaces pendientes de implementar -->

                            <a class="submenu-item"
                               href="#">

                                <span>
                                    Facturación
                                </span>

                            </a>

                            <a class="submenu-item"
                               href="#">

                                <span>
                                    Pagos
                                </span>

                            </a>

                            <a class="submenu-item"
                               href="#">

                                <span>
                                    Reportes
                                </span>

                            </a>

                        </div>

                    </div>
                }

            </nav>


            <!-- OPCIONES INFERIORES -->

            <div class="sidebar-bottom">

                <!-- CONFIGURACIÓN: SOLO ADMINISTRADOR -->
                @if (esAdministrador)
                {
                    <a class="menu-item"
                       href="#">

                        <span class="menu-icon">
                            ⚙
                        </span>

                        <span>
                            Configuración
                        </span>

                    </a>
                }

                <!-- LOGOUT: AMBOS ROLES -->

                <form method="post"
                      asp-page="/Auth/Logout">

                    <button type="submit"
                            class="menu-item"
                            style="width: 100%; text-align: left; border: none; background: transparent; color: inherit; cursor: pointer;">

                        <span class="menu-icon">
                            ↪
                        </span>

                        <span>
                            Cerrar sesión
                        </span>

                    </button>

                </form>

            </div>


            <!-- PIE DEL SIDEBAR -->

            <div class="sidebar-footer">

                <span>
                    Sistema de Gestión
                </span>

                <small>
                    © 2026 Taller Mecánico
                </small>

            </div>

        </aside>


        <!-- CONTENIDO PRINCIPAL -->

        <main class="main-content">

            <header class="topbar">

                <div>
                    <span class="topbar-label">
                        GESTIÓN DEL TALLER
                    </span>
                </div>

                <!-- USUARIO AUTENTICADO -->

                <div class="topbar-user">

                    <span class="user-icon">
                        👤
                    </span>

                    <span>
                        @nombreUsuario
                        (@(esAdministrador ? "Administrador" : esRecepcionista ? "Recepcionista" : "Usuario"))
                    </span>

                </div>

            </header>


            <section class="page-content">
                @RenderBody()
            </section>

        </main>

    </div>


    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>
</html>
