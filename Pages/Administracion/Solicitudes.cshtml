@page
@model TallerMecanico.Pages.Administracion.SolicitudesModel

@{
    ViewData["Title"] = "Aprobacion de empleados";
}

<style>
    .solicitudes-panel {
        max-width: 1100px;
        margin-inline: auto;
        color: var(--text-primary);
    }

    .solicitudes-panel h1 {
        color: var(--text-primary);
    }

    .solicitudes-panel .text-muted {
        color: var(--text-muted) !important;
    }

    .solicitudes-empty {
        padding: 44px 28px;
        text-align: center;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
    }

    .solicitudes-empty h2 {
        color: var(--text-primary);
        font-size: 1.35rem;
        margin-bottom: 12px;
    }

    .solicitudes-empty p {
        color: var(--text-secondary);
        margin-bottom: 0;
    }

    .solicitudes-panel .table-responsive {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 16px;
    }

    .solicitudes-panel .table {
        --bs-table-bg: transparent;
        --bs-table-color: var(--text-primary);
        --bs-table-striped-bg: var(--surface-light);
        --bs-table-striped-color: var(--text-primary);
        --bs-table-hover-bg: var(--surface-hover);
        --bs-table-hover-color: var(--text-primary);
        --bs-table-border-color: var(--border);
        color: var(--text-primary);
        margin-bottom: 0;
        min-width: 760px;
    }

    .solicitudes-panel .table th,
    .solicitudes-panel .table td {
        padding: 14px;
        vertical-align: middle;
    }

    .solicitudes-panel .table th {
        color: var(--text-secondary);
        background: var(--surface-light);
    }

    .solicitudes-panel .badge.bg-warning {
        background: rgba(251,191,36,.12) !important;
        color: var(--warning) !important;
        padding: 8px 10px;
        border-radius: var(--radius-sm);
    }

    .solicitudes-panel .btn {
        min-width: 90px;
        padding: 9px 14px;
        border-radius: var(--radius-sm);
        font-weight: 600;
    }

    .solicitudes-panel .btn-success {
        background: rgba(74,222,128,.12);
        color: var(--success);
        border-color: var(--success);
    }

    .solicitudes-panel .btn-danger {
        background: rgba(248,113,113,.12);
        color: var(--danger);
        border-color: var(--danger);
    }

    .solicitudes-panel .btn-success:hover {
        background: var(--success);
        color: var(--background);
    }

    .solicitudes-panel .btn-danger:hover {
        background: var(--danger);
        color: var(--background);
    }

    .solicitudes-panel .alert-success {
        background: rgba(74,222,128,.1);
        border-color: var(--success);
        color: var(--success);
    }

    .solicitudes-panel .alert-danger {
        background: rgba(248,113,113,.1);
        border-color: var(--danger);
        color: var(--danger);
    }
</style>
<div class="container py-4 solicitudes-panel">

    <div class="mb-4">
        <h1 class="fw-bold">Aprobacion de empleados</h1>
        <p class="text-muted">
            Revisa las solicitudes de empleados que ya verificaron su correo.
        </p>
    </div>

    @if (TempData["Mensaje"] is string mensaje)
    {
        <div class="alert alert-success" role="status">
            @mensaje
        </div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger" role="alert">
            @error
        </div>
    }

    @if (Model.Solicitudes.Count == 0)
    {
        <section class="solicitudes-empty" role="status">
    <h2>Todo al día</h2>
    <p>No hay solicitudes pendientes de aprobación.</p>
    <p>Las nuevas solicitudes aparecerán aquí cuando estén listas para su revisión.</p>
</section>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Usuario</th>
                        <th>Correo</th>
                        <th>Fecha de solicitud</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var solicitud in Model.Solicitudes)
                {
                    <tr>
                        <td>@solicitud.Id</td>
                        <td>@solicitud.Username</td>
                        <td>@solicitud.Email</td>
                        <td>@solicitud.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <span class="badge bg-warning text-dark">
                                Pendiente de aprobacion
                            </span>
                        </td>
                        <td>
                            <div class="d-flex flex-wrap gap-2">

                                <form method="post"
                                      asp-page-handler="Aprobar"
                                      asp-route-id="@solicitud.Id">
                                    <button type="submit"
                                            class="btn btn-success btn-sm"
                                            onclick="return confirm('¿Aprobar a este empleado?');">
                                        Aprobar
                                    </button>
                                </form>

                                <form method="post"
                                      asp-page-handler="Rechazar"
                                      asp-route-id="@solicitud.Id">
                                    <button type="submit"
                                            class="btn btn-danger btn-sm"
                                            onclick="return confirm('¿Rechazar esta solicitud?');">
                                        Rechazar
                                    </button>
                                </form>

                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>