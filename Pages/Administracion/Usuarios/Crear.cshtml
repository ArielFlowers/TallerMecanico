@page
@model TallerMecanico.Pages.Administracion.Usuarios.CrearModel

@section Styles {
    <link rel="stylesheet" href="~/css/password-toggle.css" asp-append-version="true" />
}

<style>
    /* HU3: estilos limitados a los formularios administrativos */
    .hu3-form {
        max-width: 1100px;
        margin-inline: auto;
        color: var(--text-primary);
    }

    .hu3-form h1 {
        color: var(--text-primary);
        font-size: 1.8rem;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .hu3-form .text-muted,
    .hu3-form .form-text {
        color: var(--text-muted) !important;
        line-height: 1.6;
    }

    .hu3-form > .mb-4 {
        margin-bottom: 28px !important;
    }

    .hu3-form .card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        box-shadow: 0 12px 36px rgba(0, 0, 0, 0.14);
        color: var(--text-primary);
    }

    .hu3-form .card-body {
        padding: 32px;
    }

    .hu3-form .row.mb-3 {
        align-items: start;
        margin-bottom: 24px !important;
    }

    .hu3-form .col-form-label {
        color: var(--text-secondary);
        font-size: 0.95rem;
        font-weight: 600;
        padding-top: 12px;
    }

    .hu3-form .form-control,
    .hu3-form .form-select {
        background-color: var(--surface-light);
        color: var(--text-primary);
        border: 1px solid var(--border-light);
        border-radius: var(--radius-sm);
        padding: 12px 14px;
        min-height: 44px;
        transition: border-color var(--transition),
                    box-shadow var(--transition);
    }

    .hu3-form .form-control:hover,
    .hu3-form .form-select:hover {
        border-color: var(--primary);
    }

    .hu3-form .form-control:focus,
    .hu3-form .form-select:focus {
        background-color: var(--surface-light);
        color: var(--text-primary);
        border-color: var(--primary-hover);
        box-shadow: 0 0 0 3px var(--primary-soft);
        outline: none;
    }

    .hu3-form .form-control[readonly] {
        background-color: var(--background);
        color: var(--text-secondary);
        opacity: 1;
        cursor: not-allowed;
    }

    .hu3-form .form-select option {
        background: var(--surface-light);
        color: var(--text-primary);
    }

    .hu3-form .form-check-label {
        color: var(--text-secondary);
        cursor: pointer;
    }

    .hu3-form .form-check-input {
        background-color: var(--surface-hover);
        border-color: var(--border-light);
        cursor: pointer;
    }

    .hu3-form .form-check-input:checked {
        background-color: var(--primary);
        border-color: var(--primary);
    }

    .hu3-form .form-check-input:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px var(--primary-soft);
    }

    .hu3-form .btn {
        border-radius: var(--radius-sm);
        padding: 11px 20px;
        font-weight: 600;
        min-height: 42px;
        transition: all var(--transition);
    }

    .hu3-form .btn-primary {
        background: var(--primary);
        color: #fff;
        border: 1px solid var(--primary);
    }

    .hu3-form .btn-primary:hover {
        background: var(--primary-hover);
        border-color: var(--primary-hover);
        color: #fff;
    }

    .hu3-form .btn-secondary {
        background: var(--surface-hover);
        color: var(--text-secondary);
        border: 1px solid var(--border-light);
    }

    .hu3-form .btn-secondary:hover {
        background: var(--border-light);
        color: var(--text-primary);
    }

    .hu3-form .text-danger,
    .hu3-form .field-validation-error {
        color: var(--danger) !important;
        display: block;
        margin-top: 6px;
        font-size: 0.85rem;
    }

    .hu3-form .input-validation-error {
        border-color: var(--danger) !important;
    }

    .hu3-form .alert-success {
        background: rgba(74, 222, 128, 0.1);
        border: 1px solid var(--success);
        color: var(--success);
        border-radius: var(--radius-md);
    }

    .hu3-form .btn:focus-visible,
    .hu3-form a:focus-visible {
        outline: 2px solid var(--primary-hover);
        outline-offset: 3px;
    }

    @@media (max-width: 768px) {
        .hu3-form .card-body {
            padding: 20px;
        }

        .hu3-form h1 {
            font-size: 1.5rem;
        }

        .hu3-form .col-form-label {
            padding-top: 0;
            margin-bottom: 6px;
        }

        .hu3-form .btn {
            margin-bottom: 8px;
        }
    }
</style>


@{
    ViewData["Title"] = "Crear usuario";
}

<div class="container py-4 hu3-form">
    <div class="mb-4">
        <h1 class="fw-bold">Crear usuario</h1>
        <p class="text-muted">
            Centraliza el registro de nuevos usuarios del sistema.
            El usuario deberá confirmar su correo electrónico
            antes de poder iniciar sesión.
        </p>

        <div class="mb-4 p-3 rounded"
             style="background:var(--primary-soft);
                    border:1px solid var(--border-light);">
            <div class="fw-semibold mb-1">
                <i class="bi bi-envelope-check me-2"></i>
                Verificación de correo requerida
            </div>
            <div class="form-text">
                Se enviará un enlace de verificación al correo indicado.
                La cuenta permanecerá pendiente hasta completar la activación.
            </div>
        </div>
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["MensajeExito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <form method="post">
                <div asp-validation-summary="All" class="text-danger" role="alert"></div>

                <div class="row mb-3">
                    <label asp-for="Input.Username" class="col-sm-2 col-form-label"></label>
                    <div class="col-sm-10">
                        <input asp-for="Input.Username" class="form-control" autocomplete="username" />
                        <span asp-validation-for="Input.Username" class="text-danger"></span>
                        <div class="form-text">
                            Opcional. Si lo deja vacío, se genera automáticamente a partir del
                            correo electrónico (minúsculas, sin acentos y caracteres válidos).
                            En caso de coincidencia se agrega un sufijo numérico (-1, -2, …).
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <label asp-for="Input.Email" class="col-sm-2 col-form-label"></label>
                    <div class="col-sm-10">
                        <input asp-for="Input.Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <label asp-for="Input.Rol" class="col-sm-2 col-form-label"></label>
                    <div class="col-sm-10">
                        <select asp-for="Input.Rol" class="form-select">
                            <option value="">Seleccione un rol</option>
                            <option value="Administrador">Administrador</option>
                            <option value="Recepcionista">Recepcionista</option>
                        </select>
                        <span asp-validation-for="Input.Rol" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <label asp-for="Input.Password"
                           class="col-sm-2 col-form-label">
                        Contraseña
                    </label>
                    <div class="col-sm-10">
                        <div class="password-field">
                            <input asp-for="Input.Password"
                                   type="password"
                                   class="form-control"
                                   autocomplete="new-password"
                                   minlength="8"
                                   maxlength="128" />
                            <button type="button" class="password-toggle" data-password-toggle
                                    data-password-label="contraseña" aria-controls="Input_Password"
                                    aria-label="Mostrar contraseña" aria-pressed="false" hidden>
                                <svg class="password-eye-open" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                                <svg class="password-eye-closed" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="m3 3 18 18M10.6 5.1A10.7 10.7 0 0 1 12 5c6.5 0 10 7 10 7a17.2 17.2 0 0 1-4.1 4.8M6.6 6.6C3.7 8.5 2 12 2 12s3.5 7 10 7a10.5 10.5 0 0 0 4.2-.9" />
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="Input.Password"
                               class="text-danger"></span>
                        <div class="form-text">
                            Entre 8 y 128 caracteres, con mayúscula,
                            minúscula, número y carácter especial, sin
                            espacios al principio ni al final.
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <label asp-for="Input.ConfirmarPassword"
                           class="col-sm-2 col-form-label">
                        Confirmar contraseña
                    </label>
                    <div class="col-sm-10">
                        <div class="password-field">
                            <input asp-for="Input.ConfirmarPassword"
                                   type="password"
                                   class="form-control"
                                   autocomplete="new-password"
                                   minlength="8"
                                   maxlength="128" />
                            <button type="button" class="password-toggle" data-password-toggle
                                    data-password-label="confirmación de contraseña" aria-controls="Input_ConfirmarPassword"
                                    aria-label="Mostrar confirmación de contraseña" aria-pressed="false" hidden>
                                <svg class="password-eye-open" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                                <svg class="password-eye-closed" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="m3 3 18 18M10.6 5.1A10.7 10.7 0 0 1 12 5c6.5 0 10 7 10 7a17.2 17.2 0 0 1-4.1 4.8M6.6 6.6C3.7 8.5 2 12 2 12s3.5 7 10 7a10.5 10.5 0 0 0 4.2-.9" />
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="Input.ConfirmarPassword"
                              class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-2"></div>
                    <div class="col-sm-10">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-person-plus"></i> Crear usuario y enviar verificación</button>
                        <a asp-page="./Index" class="btn btn-secondary ms-2">Cancelar</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/password-toggle.js" asp-append-version="true"></script>
}
