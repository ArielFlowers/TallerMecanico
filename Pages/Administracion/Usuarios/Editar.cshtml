@page "{id:int}"
@model TallerMecanico.Pages.Administracion.Usuarios.EditarModel

<style>
    /* HU3: estilos limitados a los formularios administrativos */
    .hu3-form {
        max-width: 1100px;
        margin-inline: auto;
        color: var(--text-primary);
    }

    .hu3-form h1 {
        color: var(--text-primary);
        font-size: 1.8rem;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .hu3-form .text-muted,
    .hu3-form .form-text {
        color: var(--text-muted) !important;
        line-height: 1.6;
    }

    .hu3-form > .mb-4 {
        margin-bottom: 28px !important;
    }

    .hu3-form .card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        box-shadow: 0 12px 36px rgba(0, 0, 0, 0.14);
        color: var(--text-primary);
    }

    .hu3-form .card-body {
        padding: 32px;
    }

    .hu3-form .row.mb-3 {
        align-items: start;
        margin-bottom: 24px !important;
    }

    .hu3-form .col-form-label {
        color: var(--text-secondary);
        font-size: 0.95rem;
        font-weight: 600;
        padding-top: 12px;
    }

    .hu3-form .form-control,
    .hu3-form .form-select {
        background-color: var(--surface-light);
        color: var(--text-primary);
        border: 1px solid var(--border-light);
        border-radius: var(--radius-sm);
        padding: 12px 14px;
        min-height: 44px;
        transition: border-color var(--transition),
                    box-shadow var(--transition);
    }

    .hu3-form .form-control:hover,
    .hu3-form .form-select:hover {
        border-color: var(--primary);
    }

    .hu3-form .form-control:focus,
    .hu3-form .form-select:focus {
        background-color: var(--surface-light);
        color: var(--text-primary);
        border-color: var(--primary-hover);
        box-shadow: 0 0 0 3px var(--primary-soft);
        outline: none;
    }

    .hu3-form .form-control[readonly] {
        background-color: var(--background);
        color: var(--text-secondary);
        opacity: 1;
        cursor: not-allowed;
    }

    .hu3-form .form-select option {
        background: var(--surface-light);
        color: var(--text-primary);
    }

    .hu3-form .form-check-label {
        color: var(--text-secondary);
        cursor: pointer;
    }

    .hu3-form .form-check-input {
        background-color: var(--surface-hover);
        border-color: var(--border-light);
        cursor: pointer;
    }

    .hu3-form .form-check-input:checked {
        background-color: var(--primary);
        border-color: var(--primary);
    }

    .hu3-form .form-check-input:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px var(--primary-soft);
    }

    .hu3-form .btn {
        border-radius: var(--radius-sm);
        padding: 11px 20px;
        font-weight: 600;
        min-height: 42px;
        transition: all var(--transition);
    }

    .hu3-form .btn-primary {
        background: var(--primary);
        color: #fff;
        border: 1px solid var(--primary);
    }

    .hu3-form .btn-primary:hover {
        background: var(--primary-hover);
        border-color: var(--primary-hover);
        color: #fff;
    }

    .hu3-form .btn-secondary {
        background: var(--surface-hover);
        color: var(--text-secondary);
        border: 1px solid var(--border-light);
    }

    .hu3-form .btn-secondary:hover {
        background: var(--border-light);
        color: var(--text-primary);
    }

    .hu3-form .text-danger,
    .hu3-form .field-validation-error {
        color: var(--danger) !important;
        display: block;
        margin-top: 6px;
        font-size: 0.85rem;
    }

    .hu3-form .input-validation-error {
        border-color: var(--danger) !important;
    }

    .hu3-form .alert-success {
        background: rgba(74, 222, 128, 0.1);
        border: 1px solid var(--success);
        color: var(--success);
        border-radius: var(--radius-md);
    }

    .hu3-form .btn:focus-visible,
    .hu3-form a:focus-visible {
        outline: 2px solid var(--primary-hover);
        outline-offset: 3px;
    }

    @@media (max-width: 768px) {
        .hu3-form .card-body {
            padding: 20px;
        }

        .hu3-form h1 {
            font-size: 1.5rem;
        }

        .hu3-form .col-form-label {
            padding-top: 0;
            margin-bottom: 6px;
        }

        .hu3-form .btn {
            margin-bottom: 8px;
        }
    }
</style>


@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="container py-4 hu3-form">
    <div class="mb-4">
        <h1 class="fw-bold">Editar Usuario: @Model.Usuario?.Username</h1>
        <p class="text-muted">
            Modifique los datos del usuario. El cambio de estado (activar/desactivar) tiene efecto inmediato.
        </p>
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["MensajeExito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (Model.Usuario != null)
    {
        <div class="card">
            <div class="card-body">
                <form method="post">
                    <input type="hidden" asp-for="Usuario.Id" />

                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">Usuario</label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control" value="@Model.Usuario.Username" readonly />
                            <div class="form-text">El nombre de usuario no se puede modificar.</div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label asp-for="Input.Email" class="col-sm-2 col-form-label"></label>
                        <div class="col-sm-10">
                            <input asp-for="Input.Email" class="form-control" autocomplete="email" />
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label asp-for="Input.Rol" class="col-sm-2 col-form-label"></label>
                        <div class="col-sm-10">
                            <select asp-for="Input.Rol" class="form-select">
                                <option value="Administrador" selected="@(Model.Input.Rol == "Administrador")">Administrador</option>
                                <option value="Recepcionista" selected="@(Model.Input.Rol == "Recepcionista")">Recepcionista</option>
                            </select>
                            <span asp-validation-for="Input.Rol" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label asp-for="Input.Activo" class="col-sm-2 col-form-label"></label>
                        <div class="col-sm-10">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="Input.Activo" />
                                <label class="form-check-label" asp-for="Input.Activo">
                                    Usuario activo (puede iniciar sesión)
                                </label>
                            </div>
                            <span asp-validation-for="Input.Activo" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-2"></div>
                        <div class="col-sm-10">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Guardar Cambios
                            </button>
                            <a asp-page="./Index" class="btn btn-secondary ms-2">Cancelar</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}