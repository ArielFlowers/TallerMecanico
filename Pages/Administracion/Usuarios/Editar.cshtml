@page "{id:int}"
@model TallerMecanico.Pages.Administracion.Usuarios.EditarModel

@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="container py-4">
    <div class="mb-4">
        <h1 class="fw-bold">Editar Usuario: @Model.Usuario?.Username</h1>
        <p class="text-muted">
            Modifique los datos del usuario. El cambio de estado (activar/desactivar) tiene efecto inmediato.
        </p>
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["MensajeExito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (Model.Usuario != null)
    {
        <div class="card">
            <div class="card-body">
                <form method="post">
                    <input type="hidden" asp-for="Usuario.Id" />

                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">Usuario</label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control" value="@Model.Usuario.Username" readonly />
                            <div class="form-text">El nombre de usuario no se puede modificar.</div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label asp-for="Input.Email" class="col-sm-2 col-form-label"></label>
                        <div class="col-sm-10">
                            <input asp-for="Input.Email" class="form-control" autocomplete="email" />
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label asp-for="Input.Rol" class="col-sm-2 col-form-label"></label>
                        <div class="col-sm-10">
                            <select asp-for="Input.Rol" class="form-select">
                                <option value="Administrador" selected="@(Model.Input.Rol == "Administrador")">Administrador</option>
                                <option value="Recepcionista" selected="@(Model.Input.Rol == "Recepcionista")">Recepcionista</option>
                            </select>
                            <span asp-validation-for="Input.Rol" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label asp-for="Input.Activo" class="col-sm-2 col-form-label"></label>
                        <div class="col-sm-10">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="Input.Activo" />
                                <label class="form-check-label" asp-for="Input.Activo">
                                    Usuario activo (puede iniciar sesión)
                                </label>
                            </div>
                            <span asp-validation-for="Input.Activo" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-2"></div>
                        <div class="col-sm-10">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Guardar Cambios
                            </button>
                            <a asp-page="./Index" class="btn btn-secondary ms-2">Cancelar</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}