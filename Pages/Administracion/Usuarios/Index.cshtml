@page
@model TallerMecanico.Pages.Administracion.Usuarios.IndexModel

<style>
    .hu3-usuarios {
        color: var(--text-primary);
        max-width: 1440px;
    }

    .hu3-usuarios h1 {
        color: var(--text-primary);
        font-weight: 700;
    }

    .hu3-usuarios .text-muted {
        color: var(--text-muted) !important;
    }

    .hu3-usuarios .table-responsive {
        background: var(--surface);
        border: 1px solid var(--surface-hover);
        border-radius: var(--radius-lg);
        padding: 16px;
        overflow-x: auto;
    }

    .hu3-usuarios .table {
        --bs-table-bg: transparent;
        --bs-table-color: var(--text-primary);
        --bs-table-striped-bg: var(--surface-light);
        --bs-table-striped-color: var(--text-primary);
        --bs-table-hover-bg: var(--surface-hover);
        --bs-table-hover-color: var(--text-primary);
        --bs-table-border-color: var(--surface-hover);
        color: var(--text-primary);
        margin-bottom: 0;
        width: 100%;
    }

    .hu3-usuarios .table th {
        background: var(--surface-light);
        color: var(--text-secondary);
        padding: 16px;
        font-weight: 600;
        white-space: nowrap;
    }

    .hu3-usuarios .table td {
        color: var(--text-primary);
        padding: 15px 16px;
        vertical-align: middle;
    }

    .hu3-usuarios .btn-primary {
        background: var(--primary);
        border-color: var(--primary);
        border-radius: var(--radius-sm);
        font-weight: 600;
        padding: 10px 18px;
    }

    .hu3-usuarios .btn-primary:hover {
        background: var(--primary-hover);
        border-color: var(--primary-hover);
    }

    .hu3-usuarios .btn-outline-primary {
        color: var(--primary-hover);
        border-color: var(--primary);
    }

    .hu3-usuarios .btn-outline-primary:hover {
        background: var(--primary);
        color: white;
    }

    .hu3-usuarios .btn-outline-warning {
        color: var(--warning);
        border-color: var(--warning);
    }

    .hu3-usuarios .btn-outline-success {
        color: var(--success);
        border-color: var(--success);
    }

    .hu3-usuarios .btn-group .btn {
        border-radius: var(--radius-sm);
        min-width: 38px;
        min-height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .hu3-usuarios .btn-group {
        gap: 8px;
    }

    .hu3-usuarios .badge {
        border-radius: 8px;
        padding: 7px 10px;
        font-weight: 600;
    }

    .hu3-usuarios .badge.bg-primary {
        background: var(--primary-soft) !important;
        color: var(--primary-hover);
    }

    .hu3-usuarios .badge.bg-danger {
        background: rgba(248, 113, 113, 0.14) !important;
        color: var(--danger);
    }

    .hu3-usuarios .badge.bg-success {
        background: rgba(74, 222, 128, 0.12) !important;
        color: var(--success);
    }

    .hu3-usuarios .badge.bg-secondary {
        background: var(--surface-hover) !important;
        color: var(--text-secondary);
    }

    .hu3-usuarios .alert {
        background: var(--surface-light);
        color: var(--text-primary);
        border-radius: var(--radius-md);
    }

    .hu3-usuarios .page-link {
        background: var(--surface);
        border-color: var(--surface-hover);
        color: var(--text-secondary);
    }

    .hu3-usuarios .page-item.active .page-link {
        background: var(--primary);
        border-color: var(--primary);
        color: white;
    }

    .hu3-usuarios .page-link:hover {
        background: var(--surface-hover);
        color: var(--text-primary);
    }

    .hu3-usuarios .page-item.disabled .page-link {
        background: var(--surface);
        color: var(--text-subtle);
    }

    .hu3-usuarios .btn-group .btn {
        min-width: 96px;
        width: auto;
        padding: 8px 12px;
        font-size: 0.85rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .hu3-usuarios .btn-group form {
        margin: 0;
    }

    /* Estadisticas administrativas HU3 */
    .hu3-usuarios .hu3-estadisticas {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 24px;
    }

    .hu3-usuarios .hu3-estadistica {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 22px;
    }

    .hu3-usuarios .hu3-estadistica span {
        display: block;
        color: var(--text-secondary);
        font-size: 0.9rem;
        margin-bottom: 10px;
    }

    .hu3-usuarios .hu3-estadistica strong {
        display: block;
        color: var(--text-primary);
        font-size: 2rem;
        line-height: 1.2;
        font-weight: 700;
    }

    .hu3-usuarios .hu3-estadistica:first-child {
        border-top: 3px solid var(--primary);
    }

    .hu3-usuarios .hu3-estadistica:nth-child(2) {
        border-top: 3px solid var(--success);
    }

    .hu3-usuarios .hu3-estadistica:nth-child(3) {
        border-top: 3px solid var(--warning);
    }

    /* Busqueda y filtros */
    .hu3-usuarios .hu3-filtros {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 24px;
        margin-bottom: 24px;
    }

    .hu3-usuarios .hu3-filtros h2 {
        color: var(--text-primary);
        font-size: 1.1rem;
        font-weight: 700;
        margin-bottom: 18px;
    }

    .hu3-usuarios .hu3-filtros .form-label {
        color: var(--text-secondary);
        font-weight: 600;
        font-size: 0.9rem;
    }

    .hu3-usuarios .hu3-filtros .form-control,
    .hu3-usuarios .hu3-filtros .form-select {
        background-color: var(--surface-light);
        color: var(--text-primary);
        border: 1px solid var(--border-light);
        border-radius: var(--radius-sm);
        min-height: 44px;
    }

    .hu3-usuarios .hu3-filtros .form-control::placeholder {
        color: var(--text-muted);
    }

    .hu3-usuarios .hu3-filtros .form-control:focus,
    .hu3-usuarios .hu3-filtros .form-select:focus {
        background-color: var(--surface-light);
        color: var(--text-primary);
        border-color: var(--primary-hover);
        box-shadow: 0 0 0 3px var(--primary-soft);
    }

    .hu3-usuarios .hu3-limpiar {
        color: var(--text-secondary);
        border: 1px solid var(--border-light);
        border-radius: var(--radius-sm);
        padding: 10px 18px;
        text-decoration: none;
    }

    .hu3-usuarios .hu3-limpiar:hover {
        color: var(--text-primary);
        background: var(--surface-hover);
    }

    .hu3-usuarios .hu3-resultados {
        color: var(--text-secondary);
        margin-bottom: 14px;
    }

    @@media (max-width: 768px) {
        .hu3-usuarios .hu3-estadisticas {
            grid-template-columns: 1fr;
        }

        .hu3-usuarios .hu3-filtros {
            padding: 16px;
        }
    }
</style>

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="container py-4 hu3-usuarios">

    <div class="mb-4 d-flex justify-content-between align-items-center">
        <div>
            <h1 class="fw-bold">Gestión de Usuarios</h1>
            <p class="text-muted">
                Listado de usuarios registrados en el sistema.
            </p>
        </div>
        <a asp-page="./Crear" class="btn btn-primary">
            <i class="bi bi-person-plus"></i> Crear Usuario
        </a>
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["MensajeExito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["MensajeError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- Contadores generales -->
    <section class="hu3-estadisticas" aria-label="Estadisticas de usuarios">
        <div class="hu3-estadistica">
            <span>Total de usuarios</span>
            <strong>@Model.TotalUsuarios</strong>
        </div>
        <div class="hu3-estadistica">
            <span>Usuarios activos</span>
            <strong>@Model.UsuariosActivos</strong>
        </div>
        <div class="hu3-estadistica">
            <span>Administradores activos</span>
            <strong>@Model.AdministradoresActivos</strong>
        </div>
    </section>

    <!-- Busqueda y filtros -->
    <section class="hu3-filtros" aria-label="Filtros de usuarios">
        <h2>Buscar y filtrar usuarios</h2>

        <form method="get" asp-page="./Index" id="hu3AutoFilterForm">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-lg-6">
                    <label asp-for="Busqueda" class="form-label">
                        Usuario o correo electronico
                    </label>
                    <input asp-for="Busqueda" id="hu3Busqueda"
                           class="form-control"
                           maxlength="100"
                           placeholder="Buscar por nombre o correo..." />
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <label asp-for="RolFiltro" class="form-label">
                        Rol
                    </label>
                    <select asp-for="RolFiltro" class="form-select" id="hu3RolFiltro">
                        <option value="">Todos los roles</option>
                        <option value="Administrador">Administrador</option>
                        <option value="Recepcionista">Recepcionista</option>
                    </select>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <label asp-for="ActivoFiltro" class="form-label">
                        Estado
                    </label>
                    <select asp-for="ActivoFiltro" class="form-select" id="hu3ActivoFiltro">
                        <option value="">Todos</option>
                        <option value="true">Activos</option>
                        <option value="false">Inactivos</option>
                    </select>
                </div>


            </div>

                        <input type="hidden" name="TamanoPagina" value="@Model.TamanoPagina" />

            <p class="mt-3 mb-0 text-muted small">
                Los resultados se actualizan automáticamente.
            </p>

        </form>
    </section>

    <p class="hu3-resultados" aria-live="polite">
        @Model.TotalRegistros usuario(s) encontrados.
    </p>
    @if (Model.Usuarios.Count == 0)
    {
        <div class="alert alert-info">
            No se encontraron usuarios con los criterios seleccionados.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>Correo electrónico</th>
                        <th>Rol</th>
                        <th>Activo</th>
                        <th>Fecha de creación</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var usuario in Model.Usuarios)
                    {
                        <tr>
                            <td>@usuario.Username</td>
                            <td>@usuario.Email</td>
                            <td>
                                <span class="badge @(usuario.Rol == "Administrador" ? "bg-danger" : "bg-primary")">
                                    @usuario.Rol
                                </span>
                            </td>
                            <td>
                                @if (usuario.Activo)
                                {
                                    <span class="badge bg-success">Sí</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No</span>
                                }
                            </td>
                            <td>@usuario.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-page="./Editar"
                                       asp-route-id="@usuario.Id"
                                       asp-route-busqueda="@Model.Busqueda"
                               asp-route-rolFiltro="@Model.RolFiltro"
                               asp-route-activoFiltro="@Model.ActivoFiltro"
                                       class="btn btn-outline-primary"
                                       title="Editar">
                                        Editar
                                    </a>
                                    @if (usuario.Activo)
                                    {
                                        <form method="post"
                                              asp-page-handler="Desactivar"
                                              asp-route-id="@usuario.Id"
                                       asp-route-busqueda="@Model.Busqueda"
                               asp-route-rolFiltro="@Model.RolFiltro"
                               asp-route-activoFiltro="@Model.ActivoFiltro"
                                              onsubmit="return confirm('¿Está seguro de que desea desactivar a este usuario? Perderá acceso al sistema inmediatamente.');">
                                            <button type="submit"
                                                    class="btn btn-outline-warning"
                                                    title="Desactivar">
                                                Desactivar
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post"
                                              asp-page-handler="Reactivar"
                                              asp-route-id="@usuario.Id"
                                       asp-route-busqueda="@Model.Busqueda"
                               asp-route-rolFiltro="@Model.RolFiltro"
                               asp-route-activoFiltro="@Model.ActivoFiltro"
                                              onsubmit="return confirm('¿Está seguro de que desea reactivar a este usuario?');">
                                            <button type="submit"
                                                    class="btn btn-outline-success"
                                                    title="Reactivar">
                                                Activar
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPaginas > 1)
        {
            <nav aria-label="Paginación de usuarios">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(!Model.HayPaginaAnterior ? "disabled" : "")">
                        @if (Model.HayPaginaAnterior)
                        {
                            <a class="page-link"
                               asp-page="./Index"
                               asp-route-pagina="@(Model.Pagina - 1)"
                               asp-route-tamanoPagina="@Model.TamanoPagina"
                               asp-route-busqueda="@Model.Busqueda"
                               asp-route-rolFiltro="@Model.RolFiltro"
                               asp-route-activoFiltro="@Model.ActivoFiltro"
                               aria-label="Anterior">
                                <span aria-hidden="true">&laquo;</span>
                            </a>
                        }
                        else
                        {
                            <span class="page-link" aria-label="Anterior" aria-disabled="true" tabindex="-1">
                                <span aria-hidden="true">&laquo;</span>
                            </span>
                        }
                    </li>

                    @for (int i = 1; i <= Model.TotalPaginas; i++)
                    {
                        <li class="page-item @(i == Model.Pagina ? "active" : "")"
                            aria-current="@(i == Model.Pagina ? "page" : "")">
                            <a class="page-link"
                               asp-page="./Index"
                               asp-route-pagina="@i"
                               asp-route-tamanoPagina="@Model.TamanoPagina"
                               asp-route-busqueda="@Model.Busqueda"
                               asp-route-rolFiltro="@Model.RolFiltro"
                               asp-route-activoFiltro="@Model.ActivoFiltro">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(!Model.HayPaginaSiguiente ? "disabled" : "")">
                        @if (Model.HayPaginaSiguiente)
                        {
                            <a class="page-link"
                               asp-page="./Index"
                               asp-route-pagina="@(Model.Pagina + 1)"
                               asp-route-tamanoPagina="@Model.TamanoPagina"
                               asp-route-busqueda="@Model.Busqueda"
                               asp-route-rolFiltro="@Model.RolFiltro"
                               asp-route-activoFiltro="@Model.ActivoFiltro"
                               aria-label="Siguiente">
                                <span aria-hidden="true">&raquo;</span>
                            </a>
                        }
                        else
                        {
                            <span class="page-link" aria-label="Siguiente" aria-disabled="true" tabindex="-1">
                                <span aria-hidden="true">&raquo;</span>
                            </span>
                        }
                    </li>
                </ul>
            </nav>

            <p class="text-center text-muted small">
                Mostrando @(((Model.Pagina - 1) * Model.TamanoPagina) + 1)
                a @Math.Min(Model.Pagina * Model.TamanoPagina, Model.TotalRegistros)
                de @Model.TotalRegistros usuario(s)
            </p>
        }
    }
</div>


@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("hu3AutoFilterForm");
            const busqueda = document.getElementById("hu3Busqueda");
            const rol = document.getElementById("hu3RolFiltro");
            const activo = document.getElementById("hu3ActivoFiltro");

            if (!form || !busqueda || !rol || !activo) return;

            let timeoutId;

            function enviarFormulario() {
                const paginaActual = form.querySelector('input[name="Pagina"]');
                if (paginaActual) {
                    paginaActual.value = 1;
                }
                form.submit();
            }

            busqueda.addEventListener("input", function () {
                clearTimeout(timeoutId);
                timeoutId = setTimeout(enviarFormulario, 500);
            });

            rol.addEventListener("change", enviarFormulario);
            activo.addEventListener("change", enviarFormulario);
        });
    </script>
}
