@page
@model TallerMecanico.Pages.Administracion.Usuarios.IndexModel

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="container py-4">

    <div class="mb-4 d-flex justify-content-between align-items-center">
        <div>
            <h1 class="fw-bold">Gestión de Usuarios</h1>
            <p class="text-muted">
                Listado de usuarios registrados en el sistema.
            </p>
        </div>
        <a asp-page="./Crear" class="btn btn-primary">
            <i class="bi bi-person-plus"></i> Crear Usuario
        </a>
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["MensajeExito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["MensajeError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (Model.Usuarios.Count == 0)
    {
        <div class="alert alert-info">
            No hay usuarios registrados.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>Correo electrónico</th>
                        <th>Rol</th>
                        <th>Activo</th>
                        <th>Fecha de creación</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var usuario in Model.Usuarios)
                    {
                        <tr>
                            <td>@usuario.Username</td>
                            <td>@usuario.Email</td>
                            <td>
                                <span class="badge @(usuario.Rol == "Administrador" ? "bg-danger" : "bg-primary")">
                                    @usuario.Rol
                                </span>
                            </td>
                            <td>
                                @if (usuario.Activo)
                                {
                                    <span class="badge bg-success">Sí</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No</span>
                                }
                            </td>
                            <td>@usuario.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-page="./Editar"
                                       asp-route-id="@usuario.Id"
                                       class="btn btn-outline-primary"
                                       title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (usuario.Activo)
                                    {
                                        <form method="post"
                                              asp-page-handler="Desactivar"
                                              asp-route-id="@usuario.Id"
                                              onsubmit="return confirm('¿Está seguro de que desea desactivar a este usuario? Perderá acceso al sistema inmediatamente.');">
                                            <button type="submit"
                                                    class="btn btn-outline-warning"
                                                    title="Desactivar">
                                                <i class="bi bi-person-x"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post"
                                              asp-page-handler="Reactivar"
                                              asp-route-id="@usuario.Id"
                                              onsubmit="return confirm('¿Está seguro de que desea reactivar a este usuario?');">
                                            <button type="submit"
                                                    class="btn btn-outline-success"
                                                    title="Reactivar">
                                                <i class="bi bi-person-check"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPaginas > 1)
        {
            <nav aria-label="Paginación de usuarios">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(!Model.HayPaginaAnterior ? "disabled" : "")">
                        @if (Model.HayPaginaAnterior)
                        {
                            <a class="page-link"
                               asp-page="./Index"
                               asp-route-pagina="@(Model.Pagina - 1)"
                               asp-route-tamanoPagina="@Model.TamanoPagina"
                               aria-label="Anterior">
                                <span aria-hidden="true">&laquo;</span>
                            </a>
                        }
                        else
                        {
                            <span class="page-link" aria-label="Anterior" aria-disabled="true" tabindex="-1">
                                <span aria-hidden="true">&laquo;</span>
                            </span>
                        }
                    </li>

                    @for (int i = 1; i <= Model.TotalPaginas; i++)
                    {
                        <li class="page-item @(i == Model.Pagina ? "active" : "")"
                            aria-current="@(i == Model.Pagina ? "page" : "")">
                            <a class="page-link"
                               asp-page="./Index"
                               asp-route-pagina="@i"
                               asp-route-tamanoPagina="@Model.TamanoPagina">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(!Model.HayPaginaSiguiente ? "disabled" : "")">
                        @if (Model.HayPaginaSiguiente)
                        {
                            <a class="page-link"
                               asp-page="./Index"
                               asp-route-pagina="@(Model.Pagina + 1)"
                               asp-route-tamanoPagina="@Model.TamanoPagina"
                               aria-label="Siguiente">
                                <span aria-hidden="true">&raquo;</span>
                            </a>
                        }
                        else
                        {
                            <span class="page-link" aria-label="Siguiente" aria-disabled="true" tabindex="-1">
                                <span aria-hidden="true">&raquo;</span>
                            </span>
                        }
                    </li>
                </ul>
            </nav>

            <p class="text-center text-muted small">
                Mostrando @(((Model.Pagina - 1) * Model.TamanoPagina) + 1)
                a @Math.Min(Model.Pagina * Model.TamanoPagina, Model.TotalRegistros)
                de @Model.TotalRegistros usuario(s)
            </p>
        }
    }
</div>