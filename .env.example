# Copiar este archivo como .env y completar los valores.
# No commitear .env.

# ============================================
# IMAGEN LOCAL
# ============================================
# Construir con docker-compose.yml y docker-compose.build.yml.
# Para usar una imagen publicada, reemplazar por su referencia con digest.
APP_IMAGE=taller-mecanico:local

# ============================================
# BASE DE DATOS COMPARTIDA EN LA NUBE (Aiven MySQL 8.4)
# ============================================
# Host y puerto: consola de Aiven > servicio MySQL > Connection information.
# Usar avnadmin y comprobar el trigger con scripts/bd/probar-trigger-nube.ps1.
MYSQL_CONNECTION=Server=CAMBIAR-xxxx.aivencloud.com;Port=CAMBIAR;Database=taller_mecanico;User ID=avnadmin;Password=CAMBIAR;SslMode=Required;Maximum Pool Size=3;

# Claves locales de docker-compose.local.yml; no son las claves de Aiven.
# MYSQL_IMAGE y TAILSCALE_IP solo se usan en el antiguo anfitrion (plan B).
TAILSCALE_IP=100.x.x.x
MYSQL_ROOT_PASSWORD=CAMBIAR_POR_CONTRASENA_ROOT
MYSQL_PASSWORD=CAMBIAR_POR_CONTRASENA_TALLER
MYSQL_DATABASE=taller_mecanico
MYSQL_USER=taller
MYSQL_IMAGE=mysql:8.4
MAILPIT_IMAGE=axllent/mailpit:latest

# Puertos del anfitrion. Cambiar si ya estan ocupados en esa PC.
# Estos puertos no se usan para conectarse a Aiven.
MYSQL_HOST_PORT=3307
MYSQL_TAILSCALE_PORT=3307
MAILPIT_SMTP_PORT=1026
MAILPIT_UI_PORT=8026

# ============================================
# CORREO DE VERIFICACION
# ============================================
# Mailpit compartido:
#   SMTP_HOST=100.x.x.x
#   SMTP_PORT=1025
#   SMTP_SECURITY=None
#   SMTP_USERNAME=
#   SMTP_PASSWORD=
#
# Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURITY=SslOnConnect
#   SMTP_USERNAME=cuenta@gmail.com
#   SMTP_PASSWORD=contrasena_de_aplicacion
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=SslOnConnect
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ============================================
# URL PUBLICA PARA ENLACES DE VERIFICACION
# ============================================
# Cada integrante abre los enlaces de verificacion en su propia instancia local.
# La aplicacion permite HTTP en loopback sin habilitar HTTP no seguro.
APP_BIND_ADDRESS=127.0.0.1
APP_PUBLIC_BASE_URL=http://127.0.0.1:8088
APP_PERMITIR_HTTP_NO_SEGURO=false
