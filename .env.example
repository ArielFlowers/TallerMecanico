# Copiar este archivo como .env en la raiz, solo si todavia no existe.
# Completar CAMBIAR con valores recibidos por un canal privado.
# Guia para cada integrante: docs/COMPARTIR_EQUIPO.md.
# No commitear .env. No definir COMPOSE_PROJECT_NAME.
# Conservar las comillas simples de las claves y la conexion: evitan expandir $.

# ============================================
# IMAGEN DE LA APLICACION
# ============================================
# NubeUp construye esta imagen desde el codigo de cada PC.
APP_IMAGE=taller-mecanico:local

# ============================================
# BASE DE DATOS COMPARTIDA EN LA NUBE (Aiven MySQL 8.4)
# ============================================
# Host y puerto: consola de Aiven > servicio MySQL > Connection information.
# Todos deben usar el MISMO servicio y la base taller_mecanico del equipo.
# La migracion y la prueba del trigger las coordina el responsable de la base.
# Mantener SslMode=Required y Maximum Pool Size=3 en las tres replicas.
MYSQL_CONNECTION='Server=CAMBIAR-xxxx.aivencloud.com;Port=CAMBIAR_PUERTO;Database=taller_mecanico;User ID=avnadmin;Password=CAMBIAR_CLAVE_AIVEN;SslMode=Required;Maximum Pool Size=3;'

# ============================================
# CORREO DE VERIFICACION EN MODO NUBE
# ============================================
# Cuenta de pruebas del equipo, o una cuenta propia por integrante.
# SMTP_PASSWORD es la clave de APLICACION de Gmail, no la clave de inicio de sesion.
# SMTP_FROM debe corresponder a la cuenta remitente configurada.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=SslOnConnect
SMTP_USERNAME=CAMBIAR_CORREO@gmail.com
SMTP_PASSWORD='CAMBIAR_CLAVE_DE_APLICACION'
SMTP_FROM='AutoTaller <CAMBIAR_CORREO@gmail.com>'

# ============================================
# URL PUBLICA PARA ENLACES DE VERIFICACION
# ============================================
# Cada integrante abre los enlaces de verificacion en su propia instancia local.
# La aplicacion permite HTTP en loopback sin habilitar HTTP no seguro.
APP_BIND_ADDRESS=127.0.0.1
APP_PUBLIC_BASE_URL=http://127.0.0.1:8088
APP_PERMITIR_HTTP_NO_SEGURO=false

# ============================================
# MYSQL LOCAL 8.4 (solo LocalUp; independientes de Aiven)
# ============================================
# Cada PC elige sus claves antes de crear su volumen local por primera vez.
# Si el volumen ya existe, conservar las claves que lo inicializaron.
MYSQL_ROOT_PASSWORD='CAMBIAR_CLAVE_ROOT_LOCAL'
MYSQL_PASSWORD='CAMBIAR_CLAVE_TALLER_LOCAL'
# Base taller_mecanico y usuario taller: fijados en docker-compose.local.yml.
# Puertos locales fijados en ese Compose: MySQL 3307, Mailpit SMTP 1025 y web 8025.
# LocalUp configura Mailpit automaticamente y no usa el SMTP de Gmail anterior.
# Las variables del antiguo anfitrion/Tailscale no se usan en estos dos modos.
