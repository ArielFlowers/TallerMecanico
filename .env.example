# Copiar este archivo como .env y completar los valores.
# No commitear .env.

# ============================================
# IMAGEN CANONICA
# ============================================
# Imagen publicada en GHCR/Docker Hub fijada por digest.
# Para construir localmente usar docker-compose.build.yml.
APP_IMAGE=ghcr.io/usuario/tallermecanico@sha256:CAMBIAR_POR_DIGEST

# ============================================
# BASE DE DATOS REMOTA COMPARTIDA
# ============================================
# IP Tailscale de la PC anfitriona.
MYSQL_CONNECTION=Server=100.x.x.x;Port=3306;Database=taller_mecanico;User ID=taller;Password=CAMBIAR_POR_CONTRASENA;

# Solo para la PC anfitriona (docker-compose.host.yml)
TAILSCALE_IP=100.x.x.x
MYSQL_ROOT_PASSWORD=CAMBIAR_POR_CONTRASENA_ROOT
MYSQL_PASSWORD=CAMBIAR_POR_CONTRASENA_TALLER
MYSQL_DATABASE=taller_mecanico
MYSQL_USER=taller
MYSQL_IMAGE=mysql:8.0@sha256:CAMBIAR_POR_DIGEST
MAILPIT_IMAGE=axllent/mailpit:latest

# Puertos del anfitrion. Cambiar si ya estan ocupados en esa PC.
# Los integrantes deben usar el mismo puerto Tailscale en MYSQL_CONNECTION y SMTP_PORT.
MYSQL_HOST_PORT=3307
MYSQL_TAILSCALE_PORT=3307
MAILPIT_SMTP_PORT=1026
MAILPIT_UI_PORT=8026

# ============================================
# CORREO DE VERIFICACION
# ============================================
# Mailpit compartido:
#   SMTP_HOST=100.x.x.x
#   SMTP_PORT=1025
#   SMTP_SECURITY=None
#   SMTP_USERNAME=
#   SMTP_PASSWORD=
#
# Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURITY=SslOnConnect
#   SMTP_USERNAME=cuenta@gmail.com
#   SMTP_PASSWORD=contrasena_de_aplicacion
SMTP_HOST=100.x.x.x
SMTP_PORT=1025
SMTP_SECURITY=None
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=AutoTaller <no-reply@autotaller.local>

# ============================================
# URL PUBLICA PARA ENLACES DE VERIFICACION
# ============================================
# Recomendado: HTTPS con certificado de Tailscale.
# APP_PUBLIC_BASE_URL=https://taller-db.tailnet.ts.net
#
# Si se usa HTTP no loopback, habilitar explicitamente
# App__PermitirHttpNoSeguro. Solo para Development.
#
# Anfitrion con la app publicada por Tailscale:
# APP_BIND_ADDRESS=100.x.x.x
# APP_PUBLIC_BASE_URL=http://100.x.x.x:8088
# APP_PERMITIR_HTTP_NO_SEGURO=true
APP_BIND_ADDRESS=127.0.0.1
APP_PUBLIC_BASE_URL=https://127.0.0.1
APP_PERMITIR_HTTP_NO_SEGURO=false
