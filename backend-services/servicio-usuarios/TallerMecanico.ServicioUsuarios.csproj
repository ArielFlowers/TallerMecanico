  </ItemGroup>
  <ItemGroup>
    <Using Include="TallerMecanico.Contratos.Usuarios" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\shared\TallerMecanico.Contratos\TallerMecanico.Contratos.csproj" />
  </ItemGroup>
</Project>
