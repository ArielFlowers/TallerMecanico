# Copiar como bd-nube.env (ignorado por Git) y completar con los datos de Aiven:
# consola de Aiven > servicio MySQL > Overview > Connection information.
# SIN comillas y SIN espacios alrededor del "=".
# Lo usan los scripts de scripts\bd\ (la app usa MYSQL_CONNECTION del .env).
NUBE_HOST=CAMBIAR-xxxx.aivencloud.com
NUBE_PUERTO=CAMBIAR
NUBE_USUARIO=avnadmin
NUBE_BD=taller_mecanico
MYSQL_PWD=CAMBIAR_POR_LA_CONTRASENA_DE_AVNADMIN
