# TallerMecanico - Test Environment Variables
# From the repository root, copy tests/.env.test.example to tests/.env.test.
# Replace placeholder values with secure credentials. NEVER commit tests/.env.test.
# This file contains only placeholders for documentation purposes.

# MySQL root password for the isolated test container (mysql-test on port 3308)
MYSQL_TEST_ROOT_PASSWORD=changeme_root_password

# MySQL password for the test_user (created automatically by MySQL image)
MYSQL_TEST_PASSWORD=changeme_user_password
